#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=google-chrome
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://dl.google.com/linux/chrome/deb/dists/stable/main/binary-amd64/Packages
VER_FULL=$(curl -fsSL --connect-timeout 10 --max-time 30 "$WEB" | sed -n '/^Package: google-chrome-stable$/,/^$/s/^Version: \([0-9][0-9.]*-[0-9]*\).*/\1/p' | head -1)
VERSION=${VER_FULL%-*}
RAMA=${VER_FULL#*-}
SOURCES=google-chrome-stable_${VERSION}-${RAMA}_amd64.deb
DOWNLOAD=https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/$SOURCES
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
printf '\n%bExtrayendo contenido del fichero .deb%b\n\n' "$VERDE" "$CIERRE"
mkdir -p "$TMP/deb"
(
    cd "$TMP/deb" || exit 1
    _data_tar=$(ar t "$TMP/$SOURCES" | grep '^data\.tar' | head -n 1)
    [ -n "$_data_tar" ] || exit 1
    case "$_data_tar" in
        *.xz)  ar p "$TMP/$SOURCES" "$_data_tar" | tar xJf - ;;
        *.zst) ar p "$TMP/$SOURCES" "$_data_tar" | zstd -dc | tar xf - ;;
        *.gz)  ar p "$TMP/$SOURCES" "$_data_tar" | tar xzf - ;;
        *.bz2) ar p "$TMP/$SOURCES" "$_data_tar" | tar xjf - ;;
        *)     ar p "$TMP/$SOURCES" "$_data_tar" | tar xf - ;;
    esac
) || exit 1

rm -rf "$TMP/deb/etc" "$TMP/deb/usr/share/man" "$TMP/deb/usr/share/doc" "$TMP/deb/usr/share/menu" "$TMP/deb/usr/share/gnome-control-center"
rm -rf "$TMP/deb"/usr/share/applications/*.desktop
rm -f "$TMP/deb/usr/bin/google-chrome"

# Symlink desktop environment icons hicolor
for pngsize in 16 24 32 48 64 128 256; do
[ -f "$TMP/deb/opt/google/chrome/product_logo_${pngsize}.png" ] || continue
mkdir -p "$TMP/deb/usr/share/icons/hicolor/${pngsize}x${pngsize}/apps"
ln -s "../../../../../../opt/google/chrome/product_logo_${pngsize}.png" "$TMP/deb/usr/share/icons/hicolor/${pngsize}x${pngsize}/apps/google-chrome.png"
done

# Symlink desktop environment icons oxygen
for pngsize in 16 24 32 48 64 128 256; do
[ -f "$TMP/deb/opt/google/chrome/product_logo_${pngsize}.png" ] || continue
mkdir -p "$TMP/deb/usr/share/icons/oxygen/base/${pngsize}x${pngsize}/apps"
ln -s "../../../../../../../opt/google/chrome/product_logo_${pngsize}.png" "$TMP/deb/usr/share/icons/oxygen/base/${pngsize}x${pngsize}/apps/google-chrome.png"
done

install -Dm 644 "$TMP/deb/opt/google/chrome/product_logo_64.png" "$PKG/usr/share/pixmaps/google-chrome.png"

mkdir -p "$TMP/deb/usr/share/applications" "$PKG/usr/bin"

cat << 'EOF' > "$PKG/usr/bin/google-chrome"
#!/bin/sh
if [ "$(id -u)" = "0" ]; then
exec /opt/google/chrome/google-chrome --test-type --user-data-dir=/root/.config/google-chrome --no-sandbox "$@"
else
exec /opt/google/chrome/google-chrome "$@"
fi
EOF
chmod 0755 "$PKG/usr/bin/google-chrome"

cat << 'EOF' > "$TMP/deb/usr/share/applications/$PRGNAM.desktop"
[Desktop Entry]
Categories=Network;WebBrowser;
Encoding=UTF-8
Exec=google-chrome %u
GenericName[es_ES]=Navegador Web
GenericName=Web Browser
Icon=google-chrome
MimeType=text/html;
Name[es_ES]=Google-chrome
Name=Google-chrome
Path=
StartupNotify=false
Terminal=false
TerminalOptions=
Type=Application
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
EOF
chmod 0644 "$TMP/deb/usr/share/applications/$PRGNAM.desktop"
cp -rfp "$TMP"/deb/* "$PKG/" || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Creamos directorio temporal de trabajo
f_directorioTemporal
# 9. Descargamos sources
f_download
# 10. Configuramos y compilamos
F_compilar
# 11. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
