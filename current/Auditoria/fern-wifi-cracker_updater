#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261121

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=fern-wifi-cracker
SRCNAM=Fern-Wifi-Cracker
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/savio-code/$PRGNAM
VERSION=$(curl -fsSL -o /dev/null -w '%{url_effective}' "$WEB/releases/latest" | sed -E 's/.*\/tag\/v?([0-9.]+).*/\1/')
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION/$SRCNAM
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="python3 PyQt5 aircrack-ng macchanger xterm python3-scapy"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

install -d "$PKG/usr/share/$PRGNAM"
cp -a --no-preserve=ownership * "$PKG/usr/share/$PRGNAM/" || exit 1
chmod 755 "$PKG/usr/share/$PRGNAM/execute.py"

install -d "$PKG/usr/bin"
cat > "$PKG/usr/bin/$PRGNAM" << EOF
#!/bin/sh
cd /usr/share/$PRGNAM && exec python3 execute.py "\$@"
EOF
chmod 755 "$PKG/usr/bin/$PRGNAM"

python3 -O -m compileall -q "$PKG/usr/share/$PRGNAM/"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
