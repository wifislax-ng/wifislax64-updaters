#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=cewl
SRCNAM=CeWL
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${SRCNAM}_updater\007"
WEB=https://github.com/digininja/$SRCNAM
VERSION=$(curl -fsSL "$WEB/releases.atom" | sed -nE 's/.*\/releases\/tag\/([^"<]+).*/\1/p' | head -n 1)
SOURCES=$VERSION.$EXTENSION
CD=$SRCNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="ruby libxml2 libxslt"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

rm -fv Gemfile.lock

# Fix gem warnings en Ruby moderno (sin duplicar si ya existen en Gemfile)
for g in getoptlong ostruct pstore; do
	grep -qE "gem ['\"]${g}['\"]" Gemfile || echo "gem '$g'" >> Gemfile
done

bundle config set --local path vendor/bundle || exit 1
bundle config set --local without development test || exit 1
bundle config build.nokogiri --use-system-libraries || exit 1

echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

bundle install -j$(nproc) || exit 1

install -d "$PKG/opt/$SRCNAM"
cp -ra --no-preserve=owner . "$PKG/opt/$SRCNAM"
chmod 755 "$PKG/opt/$SRCNAM/$PRGNAM.rb" "$PKG/opt/$SRCNAM/fab.rb"
rm -rf "$PKG/opt/$SRCNAM/.github" "$PKG/opt/$SRCNAM/.gitignore" "$PKG/opt/$SRCNAM/.dockerignore"
rm -rf "$PKG/opt/$SRCNAM"/vendor/bundle/ruby/*/cache
rm -rf "$PKG/opt/$SRCNAM"/vendor/bundle/ruby/*/extensions/*/*/*/{mkmf.log,gem_make.out}
find "$PKG/opt/$SRCNAM/vendor/bundle" -name "*.o" -delete

install -d "$PKG/usr/bin"

cat > "$PKG/usr/bin/$PRGNAM" << EOF
#!/bin/sh
BUNDLE_GEMFILE=/opt/$SRCNAM/Gemfile bundle exec /opt/$SRCNAM/$PRGNAM.rb "\$@"
EOF
chmod 755 "$PKG/usr/bin/$PRGNAM"

cat > "$PKG/usr/bin/$PRGNAM-fab" << EOF
#!/bin/sh
BUNDLE_GEMFILE=/opt/$SRCNAM/Gemfile bundle exec /opt/$SRCNAM/fab.rb "\$@"
EOF
chmod 755 "$PKG/usr/bin/$PRGNAM-fab"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Hacemos strip sobre el paquete
f_strip
# 15. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
