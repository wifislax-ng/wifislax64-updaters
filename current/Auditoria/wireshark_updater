#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=wireshark
EXTENSION=tar.xz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://www.wireshark.org/download/src
VERSION=$(curl -fsSL -A "Mozilla/5.0" "$WEB/" | grep -oE 'wireshark-[0-9]+\.[0-9]+\.[0-9]+\.tar\.xz' | sed -E 's/wireshark-([0-9.]+)\.tar\.xz/\1/' | sort -V | tail -n 1)
SOURCES=$PRGNAM-$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="
libmaxminddb
libsmi
snappy
libminizip
libilbc
opencore-amr
spandsp"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){

echo ""
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1
mkdir -p build
cd build || exit 1
  cmake \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_MANDIR=/usr/man \
    -DCMAKE_INSTALL_DOCDIR=/usr/doc \
    -DCMAKE_INSTALL_LIBDIR=lib${LIBDIRSUFFIX} \
    -DCMAKE_INSTALL_RPATH= \
    -DCMAKE_SKIP_RPATH=ON \
    -DUSE_qt6=ON \
    -Wno-dev \
    -DCMAKE_BUILD_TYPE=Release .. || exit 1
    
# Compilamos
echo ""
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1
make || exit 1
make install DESTDIR="$PKG" || exit 1

# Creamos una config basica
mkdir -p "$PKG$HOME/.$PRGNAM"

cat > "$PKG$HOME/.$PRGNAM/recent" << 'EOF'
# Main window maximized.
# TRUE or FALSE (case-insensitive).
gui.geometry_main_maximized: TRUE
# Warn if running with elevated permissions (e.g. as root).
# TRUE or FALSE (case-insensitive).
privs.warn_if_elevated: FALSE
EOF
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Hacemos strip sobre el paquete
f_strip
# 15. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
