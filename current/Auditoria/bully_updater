SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=bully
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/kimocoder/$PRGNAM
SRCNAM=$(curl -fsSL "https://api.github.com/repos/kimocoder/$PRGNAM/tags" | grep -oE '"name":\s*"v?[0-9.-]+"' | sed -E 's/.*"v?([0-9.-]+)".*/\1/' | sort -V | tail -n 1)
VERSION=$(echo "$SRCNAM" | tr '-' '.')
SOURCES=$SRCNAM.$EXTENSION
CD=$PRGNAM-$SRCNAM
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="libpcap"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){ 
echo "${VERDE}Compilando ...${CIERRE}"
make -j$(nproc) -C src CC="gcc $SLKCFLAGS -fcommon" || exit 1
make -C src install DESTDIR="${PKG}" prefix=/usr || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
