}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=hydra
SRCNAM=thc-hydra
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/vanhauser-thc/$SRCNAM
VERSION=$(curl -fsSL -o /dev/null -w '%{url_effective}' "$WEB/releases/latest" | sed -E 's/.*\/tag\/v?([0-9.]+).*/\1/')
SOURCES=v$VERSION.$EXTENSION
CD=$SRCNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="afpfs-ng postgresql18 memcached libmemcached mongo-c-driver"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
LDFLAGS="-L/usr/lib${LIBDIRSUFFIX}" \
./configure \
  --prefix=/usr \
  --mandir=/usr/man \
  --fhs || exit 1

echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1
make -j$(nproc) || exit 1
make DESTDIR="${PKG}" MANDIR=/man/man1 DATADIR=/share/hydra install || exit 1
}

