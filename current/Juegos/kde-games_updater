SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=kde-games
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://ftp.osuosl.org/.2/slackware/slackware64-current
ELGRANARCHIVO=$(curl -fsSL "$WEB/slackware${LIBDIRSUFFIX}/PACKAGES.TXT")
ELPACK=$(echo "$ELGRANARCHIVO" | grep -i game -B5 | grep "PACKAGE NAME:" | awk '{print $3}' | grep -viE 'kanagram|khangman|xgames|bsd-games|kig|nethack')
LOSEXTRAS=$(echo "$ELGRANARCHIVO" | grep "PACKAGE NAME:" | grep -E '(libkmahjongg|kmines)' | awk '{print $3}')
LOSGRANDESJUEGOS=$(printf "%s\n%s\n" "$ELPACK" "$LOSEXTRAS" | grep -v '^$' | sort -u)
VERSION=$(echo "$ELGRANARCHIVO" | grep -E '^PACKAGE NAME:  libplasma-[0-9]' | head -n 1 | sed -E 's/.*libplasma-([0-9.]+)-.*/\1/')
}

# Si el paquete no existe se descargara de internet
F_download(){
	cd "$TMP" || exit 1
	TOTAL=$(echo "$LOSGRANDESJUEGOS" | wc -l)
	echo "${CYAN}Se han detectado ${ROJO}${TOTAL}${CYAN} paquetes...${CIERRE}"
	lacuenta=1
	for JUEGO in $LOSGRANDESJUEGOS; do
		LAGRANRUTA=$(echo "$ELGRANARCHIVO" | grep -F "PACKAGE NAME:  $JUEGO" -A1 | grep "PACKAGE LOCATION:" | awk '{print $3}' | sed 's|^\./||')
		PRGNAM_JUEGO=$(echo "$JUEGO" | rev | cut -d- -f4- | rev)
		VERSION_JEUGO=$(echo "$JUEGO" | rev | cut -d- -f3 | rev)
		if [ ! -f "$TMP/$JUEGO" ]; then
			echo ""
			echo "${CYAN}Descargando source nº ${ROJO}${lacuenta}/${TOTAL}${CYAN} de ${PRGNAM_JUEGO}-${VERSION_JEUGO}${CIERRE}"
			wget -N -L -c -q --show-progress --no-passive-ftp "$WEB/$LAGRANRUTA/$JUEGO" || exit 1
		fi
		lacuenta=$((lacuenta + 1))
	done
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
	echo ""
	echo "${VERDE}Descomprimiendo ...${CIERRE}"
	sleep 1
	for JUEGO in $LOSGRANDESJUEGOS; do
		installpkg --root "$PKG" "$TMP/$JUEGO" || exit 1
	done
	rm -rf "$PKG/var/log/packages" "$PKG/var/log/scripts" "$PKG/var/log/setup" "$PKG/install"

	if [ -d "$PKG/usr/share/applications" ]; then
		find "$PKG/usr/share/applications" -type f -name '*.desktop' -exec sed -i 's/Education;//g; s/Education//g' {} +
	fi
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# Si se cierra el script inesperadamente, ejecutar la funcion de limpieza
trap f_exitmode SIGHUP SIGINT SIGTERM

#Inicializamos las variables globales
f_variables
