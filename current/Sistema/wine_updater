############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=wine
EXTENSION=tar.xz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB="https://dl.winehq.org/wine/source"
RAMA=$(curl -fsSL --connect-timeout 10 --max-time 20 "$WEB/" | grep -oE '[0-9]+\.x/' | cut -d. -f1 | sort -n | tail -n1)
VERSION=$(curl -fsSL --connect-timeout 10 --max-time 20 "$WEB/$RAMA.x/" | grep -oE 'wine-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.xz' | sed -E 's/^wine-|\.tar\.xz$//g' | sort -V | tail -n1)
SOURCES="$PRGNAM-$VERSION.$EXTENSION"
CD="$PRGNAM-$VERSION"
DOWNLOAD="$WEB/$RAMA.x/$SOURCES"
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="wine-gecko wine-mono"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

    ./configure \
    --prefix=/usr \
    --libdir=/usr/lib$LIBDIRSUFFIX \
    --disable-tests \
    --enable-archs=x86_64,i386 \
    --enable-build-id || exit 1

echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

make || exit 1
make prefix="$PKG/usr" \
     libdir="$PKG/usr/lib$LIBDIRSUFFIX" \
     dlldir="$PKG/usr/lib$LIBDIRSUFFIX/wine" install || exit 1
  
# Add font configuration:
# Make dirs
install -d "$PKG/etc/fonts/conf.avail" "$PKG/etc/fonts/conf.d"
# Make file config
cat << 'EOF' > "$PKG/etc/fonts/conf.avail/30-win32-aliases.conf"
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <alias binding="same">
    <family>MS Shell Dlg</family>
    <accept><family>Microsoft Sans Serif</family></accept>
    <default><family>sans-serif</family></default>
  </alias>
  <alias binding="same">
    <family>MS Shell Dlg 2</family>
    <accept><family>Tahoma</family></accept>
    <default><family>sans-serif</family></default>
  </alias>

  <alias binding="same">
    <family>MS Sans Serif</family>
    <prefer><family>Microsoft Sans Serif</family></prefer>
    <default><family>sans-serif</family></default>
  </alias>
</fontconfig>
EOF
# Linked
ln -sf /etc/fonts/conf.avail/30-win32-aliases.conf "$PKG/etc/fonts/conf.d/30-win32-aliases.conf"

# Wine.conf
install -d "$PKG/usr/lib$LIBDIRSUFFIX/binfmt.d/"
cat << 'EOF' > "$PKG/usr/lib$LIBDIRSUFFIX/binfmt.d/wine.conf"
# Start WINE on Windows executables
:DOSWin:M::MZ::/usr/bin/wine:
EOF

# Create Wine menu structure:
install -d "$PKG/etc/xdg/menus/applications-merged"
cat << 'EOF' > "$PKG/etc/xdg/menus/applications-merged/wine.menu"
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
"http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>wine-wine</Name>
    <Directory>wine-wine.directory</Directory>
    <Include>
      <Category>Wine</Category>
    </Include>
  </Menu>
</Menu>
EOF

