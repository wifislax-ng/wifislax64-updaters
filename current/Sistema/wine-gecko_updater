VERSION=$(curl -fsSL --connect-timeout 10 --max-time 20 "$WEB/" | grep -oE 'href="[0-9]+\.[0-9]+(\.[0-9]+)?/"' | tr -d 'href="/' | sort -V | tail -n1)
VERSION=${VERSION:-2.47.4}
SOURCES="$PRGNAM-$VERSION-$ARCH.$EXTENSION"
DOWNLOAD="$WEB/$VERSION/$SOURCES"
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo "Incluyendo version x86 ..."
	if [ ! -s "$PRGNAM-$VERSION-x86.$EXTENSION" ]; then
		wget -c -q --show-progress "$WEB/$VERSION/$PRGNAM-$VERSION-x86.$EXTENSION" || exit 1
	fi
mkdir -p "$PKG/usr/share/wine/gecko"
mv -f *."$EXTENSION" "$PKG/usr/share/wine/gecko/" || exit 1
chmod 644 "$PKG/usr/share/wine/gecko"/*
}

