############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=slapt-get
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB="https://github.com/jaos/$PRGNAM"
VERSION=$(git ls-remote --tags --refs "$WEB.git" | awk -F/ '{print $NF}' | sort -V | tail -n1)
SOURCES="$VERSION.$EXTENSION"
CD="$PRGNAM-$VERSION"
DOWNLOAD="$WEB/archive/refs/tags/$SOURCES"
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
rm -rf build
CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
	meson setup build \
	  --prefix=/usr \
	  --libdir=/usr/lib${LIBDIRSUFFIX} \
	  --sysconfdir=/etc \
	  --mandir=/usr/man \
	  --buildtype=release \
	  -Dwerror=false || exit 1

ninja -C build ${NUMJOBS:--j$(nproc 2>/dev/null || echo 1)} || exit 1
DESTDIR="$PKG" ninja -C build install || exit 1

# Copiamos nuestra config actual al paquete
mkdir -p "$PKG/etc/slapt-get"
rm -rf "$PKG/etc/slapt-get/slapt-getrc.new"
cp -f /etc/slapt-get/slapt-getrc "$PKG/etc/slapt-get/"
}

