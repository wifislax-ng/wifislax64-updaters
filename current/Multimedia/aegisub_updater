############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
	. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
	PRGNAM=aegisub
	SRCNAM=Aegisub
	EXTENSION=tar.gz
	GESTOR=wget
	echo -ne "\033]2;${PRGNAM}_updater\007"
	WEB=https://github.com/TypesettingTools/$SRCNAM
	VERSION=$(curl -s $WEB/tags|grep [0-9].$EXTENSION|head -1|cut -d/ -f7|sed 's/v//g'|cut -dt -f-1|sed 's/.$//g')
	SOURCES=v$VERSION.$EXTENSION
	CD=$SRCNAM-$VERSION
	DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="
unifdef
libwpe
wpebackend-fdo
bubblewrap
geoclue2
xdg-dbus-proxy
webkit2gtk4.1
nanosvg
wxWidgets
ffms2
libuchardet"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "$VERDE"Configurando ..."$CIERRE"
sleep 1

  sed "/subdir('tests')/d" -i meson.build
  echo "#define BUILD_GIT_VERSION_NUMBER ${VERSION/./}" >> git_version.h
  echo "#define BUILD_GIT_VERSION_STRING \"${VERSION}\"" >> git_version.h
  echo '#define TAGGED_RELEASE 0' >> git_version.h
  echo '#define INSTALLER_VERSION "0.0.0"' >> git_version.h
  echo '#define RESOURCE_BASE_VERSION 0, 0, 0' >> git_version.h

echo 
echo "$VERDE"Compilando ..."$CIERRE"
  
mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS -fpermissive" \
  meson .. \
    --buildtype=release \
    --infodir=/usr/info \
    --libdir=/usr/lib${LIBDIRSUFFIX} \
    --localstatedir=/var \
    --mandir=/usr/man \
    --prefix=/usr \
    --sysconfdir=/etc \
    -Dopenal=disabled \
    -Dportaudio=disabled \
    -Dsystem_luajit=true \
    -Denable_update_checker=false \
    -Dstrip=true
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
}

