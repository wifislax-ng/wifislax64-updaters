F_variables() {
PRGNAM=vlc
EXTENSION=tar.xz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://get.videolan.org/vlc/last
VERSION=$(wget -qO- "$WEB/" | grep -oE 'vlc-[0-9]+\.[0-9]+(\.[0-9]+)?\.tar\.xz' | sed -E 's/vlc-([0-9.]+)\.tar\.xz/\1/' | sort -V | tail -n 1)
CD="$PRGNAM-$VERSION"
SOURCES="$PRGNAM-$VERSION.$EXTENSION"
DOWNLOAD="https://download.videolan.org/pub/videolan/$PRGNAM/$VERSION/$SOURCES"
}

