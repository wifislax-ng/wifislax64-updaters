SRCNAM=FFmpeg
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://github.com/$SRCNAM/$SRCNAM
VERSION=$(ls /var/lib/pkgtools/packages | grep -E '^ffmpeg-[0-9]' | cut -d- -f2 | head -n 1)
SOURCES=n$VERSION.$EXTENSION
CD=$SRCNAM-n$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

