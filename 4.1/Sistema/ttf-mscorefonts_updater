#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=ttf-mscorefonts
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB="https://downloads.sourceforge.net/project/corefonts/the%20fonts/final/"
VERSION=0.1
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="cabextract"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "$CYAN"Descargando sources de $PRGNAM-$VERSION"$CIERRE"

	for x in andale32.exe arial32.exe arialb32.exe comic32.exe courie32.exe georgi32.exe impact32.exe times32.exe trebuc32.exe verdan32.exe wd97vwr32.exe webdin32.exe; do
		if [ ! -s "$x" ]; then
			wget -c -q --show-progress "${WEB}${x}" -O "$x" || exit 1
		fi
	done
	
rm -rf "$PRGNAM-$VERSION"
mkdir -p "$PRGNAM-$VERSION"
mv *.exe "$PRGNAM-$VERSION/"
cd "$PRGNAM-$VERSION" || exit 1
chown -R root:root .
find -L . \
\( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
-o -perm 511 \) -exec chmod 755 {} \; -o \
\( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
-o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;
  
mkdir -p "$PKG/usr/share/fonts/TTF/msttcorefonts"
cabextract *.exe -L -F '*.[tT][tT][fF]' -d "$PKG/usr/share/fonts/TTF/msttcorefonts" || exit 1
chmod 644 "$PKG/usr/share/fonts/TTF/msttcorefonts"/*.ttf 2>/dev/null
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Configuramos y compilamos
F_compilar
# 11. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
