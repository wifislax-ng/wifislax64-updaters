#!/bin/sh

# Script by USUARIONUEVO @ www.seguridadwireless.net
# Versión optimizada, endurecida y compatible con POSIX

# Comprobar permisos de root antes de tocar el sistema
if [ "$(id -u)" -ne 0 ]; then
    printf "Error: Este script debe ejecutarse como root.\n" >&2
    exit 1
fi

# Eliminamos posibles ficheros viejos de modificaciones de scripts
rm -rf /opt/wifislax-updaters/*/*~ >/dev/null 2>&1

readonly SCRIPT_VERSION=20261125

# Configuración de colores (segura para cualquier terminal)
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    readonly RESET=$(tput sgr0)
    readonly ROJO=$(tput setaf 9 2>/dev/null || tput setaf 1)
    readonly VERDE=$(tput setaf 10 2>/dev/null || tput setaf 2)
    readonly AMARILLO=$(tput setaf 11 2>/dev/null || tput setaf 3)
    readonly ROSA=$(tput setaf 13 2>/dev/null || tput setaf 5)
    readonly CYAN=$(tput setaf 14 2>/dev/null || tput setaf 6)
    readonly BLANCO=$(tput setaf 15 2>/dev/null || tput setaf 7)
else
    readonly RESET=""
    readonly ROJO=""
    readonly VERDE=""
    readonly AMARILLO=""
    readonly ROSA=""
    readonly CYAN=""
    readonly BLANCO=""
fi
readonly CIERRE="$RESET"

# Verificar herramientas esenciales antes de perder tiempo compilando
DEPENDENCIAS="curl wget tar make gcc bc bison flex sha256sum dir2xzm xzm2dir"
for cmd in $DEPENDENCIAS; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf "%bError: Falta la herramienta requerida '%s'. Instálala antes de continuar.%b\n" "$ROJO" "$cmd" "$RESET" >&2
        exit 1
    fi
done

# Aseguramos la existencia del directorio de compilación y comprobamos espacio libre (mínimo 8 GB = 8388608 KB)
mkdir -p /usr/src || {
    printf "%bError: No se pudo crear el directorio /usr/src.%b\n" "$ROJO" "$RESET" >&2
    exit 1
}
ESPACIO_LIBRE=$(df -Pk /usr/src | awk 'NR==2 {print $4}')
if [ -n "$ESPACIO_LIBRE" ] && [ "$ESPACIO_LIBRE" -lt 8388608 ]; then
    printf "%bAdvertencia: Tienes menos de 8 GB libres en /usr/src (%s GB).%b\n" "$AMARILLO" "$((ESPACIO_LIBRE / 1024 / 1024))" "$RESET"
    printf "%bLa compilación podría fallar por falta de espacio. ¿Continuar de todos modos? [s/N]: %b" "$AMARILLO" "$RESET"
    read -r CONT_ESPACIO
    case "$CONT_ESPACIO" in
        [sSyY]) ;;
        *) exit 1 ;;
    esac
fi

# Verificar espacio libre en $HOME (mínimo 1.5 GB = 1572864 KB para contenedor y .xzm final)
ESPACIO_HOME=$(df -Pk "$HOME" | awk 'NR==2 {print $4}')
if [ -n "$ESPACIO_HOME" ] && [ "$ESPACIO_HOME" -lt 1572864 ]; then
    printf "%bAdvertencia: Tienes menos de 1.5 GB libres en %s (%s MB).%b\n" "$AMARILLO" "$HOME" "$((ESPACIO_HOME / 1024))" "$RESET"
    printf "%bEl empaquetado final del módulo .xzm podría fallar por falta de espacio/RAM. ¿Continuar? [s/N]: %b" "$AMARILLO" "$RESET"
    read -r CONT_HOME
    case "$CONT_HOME" in
        [sSyY]) ;;
        *) exit 1 ;;
    esac
fi

# Variables globales
# El PRGNAM2 se usa en la creación del xzm, NO BORRAR
# KARCH se usará siempre x86 ya que especifica arquitectura "PC"
ARCH=$(uname -m)
VMLINUZ="vmlinuz"
PRGNAM2="kernel"
PRGNAM="linux"
KARCH="x86"
SCRIPTNAME="linux_updater"
TAG="wifislax"
M0DNUM="000"
MODNAM="Kernel"
BUILD="1"
WEB="https://www.kernel.org"

# Variables para limpieza automática en caso de interrupción
FUENTES=""
CONTAINER=""

limpiar_temporales() {
    _lt_exit_code=$?
    trap - EXIT INT TERM
    # Restaurar gobernador de CPU a schedutil/ondemand al salir
    if command -v cpupower >/dev/null 2>&1; then
        cpupower frequency-set -g schedutil >/dev/null 2>&1
    fi
    if [ "$_lt_exit_code" -ne 0 ]; then
        printf "\n%bLimpiando archivos temporales tras interrupción o error...%b\n" "$AMARILLO" "$RESET" >&2
        [ -n "$CONTAINER" ] && [ -d "$CONTAINER" ] && rm -rf "$CONTAINER"
        [ -n "$FUENTES" ] && [ -d "$FUENTES" ] && rm -rf "$FUENTES"
    fi
}
trap limpiar_temporales EXIT INT TERM

# Detección segura de la versión de Wifislax
if [ -r /etc/wifislax-version ]; then
    WIFISLAX=$(awk '{print $2}' /etc/wifislax-version | cut -d'_' -f1)
else
    WIFISLAX="desconocida"
fi

# Detección robusta del directorio Escritorio
if command -v xdg-user-dir >/dev/null 2>&1; then
    ESCRITORIO=$(basename "$(xdg-user-dir DESKTOP)")
elif [ -r /root/.config/user-dirs.dirs ]; then
    ESCRITORIO=$(awk -F'"' '/XDG_DESKTOP_DIR/{print $2}' /root/.config/user-dirs.dirs | xargs basename)
else
    ESCRITORIO="Desktop"
fi

# Detección limpia del kernel y rama actuales
KERNEL_ACTUAL=$(uname -r)
KERNEL_SISTEMA="${KERNEL_ACTUAL%%-*}"
RAMA_SISTEMA="${KERNEL_SISTEMA%.*}"

export MAKEFLAGS="-j$(nproc)"

# Usar ccache automáticamente si está disponible en el sistema (solo si no estamos en modo Live sin persistencia)
if command -v ccache >/dev/null 2>&1 && [ ! -d /mnt/live ]; then
    export CCACHE_DIR="/root/.ccache"
    USE_CCACHE="TRUE"
else
    USE_CCACHE=""
fi

# Título de terminal (solo si es interactiva)
[ -t 1 ] && printf '\033]2;%s_updater\007' "$PRGNAM"

# Bienvenida
clear
cat << EOF
${ROSA}
      __ __                 __  _____                _ __       
     / // /__ _______  ___ / / / ___/__  __ _  ___  (_) /__ ____
    / ,< / -_) __/ _ \/ -_) / / /__/ _ \/  ' \/ _ \/ / / -_) __/
   /_/|_|\__/_/ /_//_/\__/_/  \___/\___/_/_/_/ .__/_/_/\__/_/   
                                            /_/                  
${AMARILLO}   ##### By USUARIONUEVO @ www.seguridadwireless.net #####${RESET}
EOF

if [ -n "$USE_CCACHE" ]; then
    printf "\n%b[INFO] ccache detectado (%s): acelerando compilación con caché.%b\n" "$VERDE" "$CCACHE_DIR" "$RESET"
fi

# Configuración y comprobación de red
HOST_COMPROBACION="https://www.kernel.org"
MAX_INTENTOS=3
TIEMPO_ESPERA=4

verificar_internet() {
    _vi_intento=1
    while [ "$_vi_intento" -le "$MAX_INTENTOS" ]; do
        if curl --silent --head --fail --max-time "$TIEMPO_ESPERA" "$HOST_COMPROBACION" >/dev/null 2>&1; then
            return 0
        fi
        printf "%bSin respuesta (intento %s de %s). Reintentando...%b\n" "$AMARILLO" "$_vi_intento" "$MAX_INTENTOS" "$RESET" >&2
        sleep 2
        _vi_intento=$((_vi_intento + 1))
    done
    return 1
}

if ! verificar_internet; then
    printf "\n%bError: Sin conexión a internet tras %s intentos.%b El script se cerrará...%b\n\n" "$ROJO" "$MAX_INTENTOS" "$BLANCO" "$RESET" >&2
    exit 1
fi

# Comprobar actualizaciones del propio script
SERVIDOR_WEB="https://raw.githubusercontent.com/wifislax-ng/wifislax64-updaters/master/$WIFISLAX"
DIRECTORIO=$(find /opt/wifislax-updaters -type f -name "$SCRIPTNAME" -printf '%h\n' 2>/dev/null | head -n 1)

SV_DIA=$(printf '%s' "$SCRIPT_VERSION" | cut -c 7-8)
SV_MES=$(printf '%s' "$SCRIPT_VERSION" | cut -c 5-6)
SV_ANO=$(printf '%s' "$SCRIPT_VERSION" | cut -c 1-4)
printf "\n%bVersión Script%b: %b%s%b/%b%s%b/%b%s%b\n\n" "$CYAN" "$RESET" "$ROJO" "$SV_DIA" "$BLANCO" "$AMARILLO" "$SV_MES" "$BLANCO" "$ROJO" "$SV_ANO" "$RESET"

if [ -n "$DIRECTORIO" ] && [ -w "$DIRECTORIO/$SCRIPTNAME" ]; then
    SERVIDOR_VERSION=$(curl -fsSL --max-time 4 "$SERVIDOR_WEB/${DIRECTORIO##*/}/$SCRIPTNAME" 2>/dev/null | awk -F'=' '/^readonly SCRIPT_VERSION=|^SCRIPT_VERSION=/{print $2; exit}')
    case "$SERVIDOR_VERSION" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
            if [ "$SCRIPT_VERSION" -lt "$SERVIDOR_VERSION" ]; then
                SRV_DIA=$(printf '%s' "$SERVIDOR_VERSION" | cut -c 7-8)
                SRV_MES=$(printf '%s' "$SERVIDOR_VERSION" | cut -c 5-6)
                SRV_ANO=$(printf '%s' "$SERVIDOR_VERSION" | cut -c 1-4)
                printf "%bComprobando actualizaciones para el script... %b¡NUEVA VERSIÓN DISPONIBLE!%b\n" "$ROSA" "$ROJO" "$RESET"
                printf "%bVersión Server%b: %b%s%b/%b%s%b/%b%s%b\n\n" "$ROSA" "$RESET" "$ROJO" "$SRV_DIA" "$BLANCO" "$AMARILLO" "$SRV_MES" "$BLANCO" "$ROJO" "$SRV_ANO" "$RESET"
                printf "%bActualizando %s...%b\n" "$CYAN" "$SCRIPTNAME" "$RESET"
                if curl -fsSL --max-time 10 "$SERVIDOR_WEB/${DIRECTORIO##*/}/$SCRIPTNAME" -o "$DIRECTORIO/$SCRIPTNAME.tmp"; then
                    chmod +x "$DIRECTORIO/$SCRIPTNAME.tmp"
                    mv -f "$DIRECTORIO/$SCRIPTNAME.tmp" "$DIRECTORIO/$SCRIPTNAME"
                    printf "%bLISTO. Reiniciando script...%b\n\n" "$VERDE" "$RESET"
                    exec "$0" "$@"
                else
                    rm -f "$DIRECTORIO/$SCRIPTNAME.tmp"
                    printf "%bNo se pudo descargar la actualización. Continuando con la versión local...%b\n\n" "$AMARILLO" "$RESET"
                fi
            fi
            ;;
    esac
fi

# Obtener listado oficial estructurado (JSON) desde kernel.org
JSON_RELEASES=$(curl -fsSL --max-time 10 "$WEB/releases.json")
if [ -z "$JSON_RELEASES" ]; then
    printf "%bError: No se pudo obtener la lista de versiones desde %s/releases.json%b\n" "$ROJO" "$WEB" "$RESET" >&2
    exit 1
fi

# Extraer versiones limpias desde el JSON (Python3 con respaldo en grep)
if command -v python3 >/dev/null 2>&1; then
    VERSIONES_EXTR=$(printf '%s' "$JSON_RELEASES" | python3 -c '
import sys, json
data = json.load(sys.stdin)
releases = data.get("releases", [])
rama = sys.argv[1]
v_rama = next((r["version"] for r in releases if r["version"].startswith(rama + ".")), "")
v_stable = next((r["version"] for r in releases if r.get("moniker") == "stable"), "")
v_rc = next((r["version"] for r in releases if r.get("moniker") == "mainline"), "")
print(f"{v_rama}|{v_stable}|{v_rc}")
' "$RAMA_SISTEMA")
    VER_RAMA=$(printf '%s' "$VERSIONES_EXTR" | cut -d'|' -f1)
    VER_STABLE=$(printf '%s' "$VERSIONES_EXTR" | cut -d'|' -f2)
    VER_RC=$(printf '%s' "$VERSIONES_EXTR" | cut -d'|' -f3)
else
    VER_RAMA=$(printf '%s\n' "$JSON_RELEASES" | grep -oE '"version": "'"${RAMA_SISTEMA}"'\.[0-9]+"' | head -n 1 | cut -d'"' -f4)
    VER_STABLE=$(printf '%s\n' "$JSON_RELEASES" | grep -A 3 '"moniker": "stable"' | grep '"version":' | head -n 1 | cut -d'"' -f4)
    VER_RC=$(printf '%s\n' "$JSON_RELEASES" | grep -A 3 '"moniker": "mainline"' | grep '"version":' | head -n 1 | cut -d'"' -f4)
fi

# Menú de opciones compatible POSIX
CUSTOM="FALSE"
while true; do
    printf "\n1) %bSeguir rama del sistema (%s) %b(recomendado)%b\n" "$VERDE" "${VER_RAMA:-rama EOL / no disponible}" "$AMARILLO" "$RESET"
    printf "2) %bÚltimo disponible como estable (%s)%b\n" "$VERDE" "${VER_STABLE:-desconocido}" "$RESET"
    printf "3) %bElegir uno custom (manual)%b\n" "$VERDE" "$RESET"
    printf "4) %bÚltimo disponible mainline/rcX (%s)%b\n" "$VERDE" "${VER_RC:-desconocido}" "$RESET"
    printf "\nSelecciona una opción: "
    read -r REPLY
    case "$REPLY" in
        1)
            if [ -z "$VER_RAMA" ]; then
                printf "%bLa rama %s ya no tiene soporte activo en kernel.org. Elige otra opción.%b\n" "$ROJO" "$RAMA_SISTEMA" "$RESET"
                continue
            fi
            KERNEL_ELEGIDO="$VER_RAMA"
            break
            ;;
        2)
            KERNEL_ELEGIDO="$VER_STABLE"
            break
            ;;
        3)
            CUSTOM="TRUE"
            break
            ;;
        4)
            KERNEL_ELEGIDO="$VER_RC"
            break
            ;;
        *)
            printf "%bOpción inválida. Elige un número del 1 al 4.%b\n" "$ROJO" "$RESET"
            ;;
    esac
done

if [ "$CUSTOM" = "TRUE" ]; then
    printf "\n%bEscribe el número de kernel exacto que quieres compilar (ej. 6.12.118) y pulsa %bENTER%b:\n" "$VERDE" "$BLANCO" "$RESET"
    read -r KERNEL_ELEGIDO
    KERNEL_ELEGIDO=$(printf '%s' "$KERNEL_ELEGIDO" | tr -d ' ')
fi

if [ -z "$KERNEL_ELEGIDO" ]; then
    printf "%bError: No se pudo determinar una versión de kernel válida.%b\n" "$ROJO" "$RESET" >&2
    exit 1
fi

# Construir URL de descarga según tipo de versión (rcX vs estándar)
FAMILIA="${KERNEL_ELEGIDO%%.*}"
case "$KERNEL_ELEGIDO" in
    *-rc*)
        ARCHIVO_TAR="$PRGNAM-$KERNEL_ELEGIDO.tar.gz"
        DESCARGA="https://git.kernel.org/torvalds/t/$ARCHIVO_TAR"
        ;;
    *)
        ARCHIVO_TAR="$PRGNAM-$KERNEL_ELEGIDO.tar.xz"
        DESCARGA="https://cdn.kernel.org/pub/linux/kernel/v${FAMILIA}.x/$ARCHIVO_TAR"
        ;;
esac

FUENTES="/usr/src/$PRGNAM-$KERNEL_ELEGIDO"
cd /usr/src || exit 1

# Descargar fuentes si no existen previamente (barra de progreso en rosa)
if [ ! -f "$ARCHIVO_TAR" ]; then
    printf "\n%bDescargando fuentes de %s-%s ...%b\n" "$CYAN" "$PRGNAM" "$KERNEL_ELEGIDO" "$ROSA"
    if ! wget -N -L -c -q --show-progress "$DESCARGA" -O "$ARCHIVO_TAR"; then
        printf "%b" "$RESET"
        rm -f "$ARCHIVO_TAR"
        printf "\n%bError al descargar %s. Verifica que la versión exista.%b\n" "$ROJO" "$DESCARGA" "$RESET" >&2
        exit 1
    fi
    printf "%b" "$RESET"
else
    printf "\n%bEl archivo %s ya existe en /usr/src. Omitiendo descarga.%b\n" "$AMARILLO" "$ARCHIVO_TAR" "$RESET"
fi

# Validar integridad SHA256 para versiones estándar
case "$KERNEL_ELEGIDO" in
    *-rc*) ;;
    *)
        URL_SHA="https://cdn.kernel.org/pub/linux/kernel/v${FAMILIA}.x/sha256sums.asc"
        HASH_ESPERADO=$(curl -fsSL --max-time 10 "$URL_SHA" 2>/dev/null | awk -v f="$ARCHIVO_TAR" '$2 == f {print $1}')
        if [ -n "$HASH_ESPERADO" ]; then
            printf "%bVerificando integridad SHA256...%b\n" "$CYAN" "$RESET"
            if ! printf "%s  %s\n" "$HASH_ESPERADO" "$ARCHIVO_TAR" | sha256sum -c --status; then
                printf "%bError: El archivo descargado está corrupto (fallo de SHA256). Borrando...%b\n" "$ROJO" "$RESET" >&2
                rm -f "$ARCHIVO_TAR"
                exit 1
            fi
            printf "%bIntegridad verificada correctamente.%b\n" "$VERDE" "$RESET"
        fi
        ;;
esac

# Limpiar compilación anterior si existiera
rm -rf "$FUENTES"

# Descomprimir fichero
printf "\n%bDescomprimiendo %s ...%b\n" "$VERDE" "$ARCHIVO_TAR" "$RESET"
if ! tar xf "$ARCHIVO_TAR"; then
    printf "%bError al descomprimir %s. El archivo podría estar corrupto.%b\n" "$ROJO" "$ARCHIVO_TAR" "$RESET" >&2
    exit 1
fi

cd "$FUENTES" || exit 1
make mrproper

# Convertir e integrar logo personalizado de Wifislax si existe
LOGO="/usr/share/pixmaps/wifislax_logo_blue.png"
LOGONEW="$FUENTES/drivers/video/logo/logo_linux_clut224.ppm"
if [ -f "$LOGO" ] && command -v pngtopnm >/dev/null 2>&1; then
    printf "\n%bConvirtiendo logo de arranque...%b\n" "$VERDE" "$RESET"
    pngtopnm "$LOGO" | ppmquant 224 | pnmtoplainpnm > "$LOGONEW" || exit 1
fi

# Gestión del archivo .config
if [ ! -f "$FUENTES/.config" ]; then
    printf "\n%bNo se detectó fichero .config personalizado.\n" "$CYAN"
    printf "Si deseas usar uno propio, cópialo ahora a: %s/.config\n" "$FUENTES"
    printf "De lo contrario, se extraerá la configuración del kernel actual.\n"
    printf "Pulsa %bENTER%b para continuar...%b\n\n" "$AMARILLO" "$CYAN" "$RESET"
    read -r
fi

if [ -f "$FUENTES/.config" ]; then
    printf "\n%bUsando fichero .config proporcionado por el usuario...%b\n\n" "$VERDE" "$RESET"
else
    printf "\n%bGenerando .config a partir del kernel en ejecución...%b\n\n" "$VERDE" "$RESET"
    modprobe configs 2>/dev/null
    if [ -r /proc/config.gz ]; then
        zcat /proc/config.gz > "$FUENTES/.config"
    elif [ -r "/boot/config-$KERNEL_ACTUAL" ]; then
        cp "/boot/config-$KERNEL_ACTUAL" "$FUENTES/.config"
    else
        printf "%bError: No se encontró configuración base en /proc/config.gz ni en /boot.%b\n" "$ROJO" "$RESET" >&2
        exit 1
    fi
fi

# Actualizar configuración y abrir configurador visual o de terminal
make olddefconfig || exit 1

if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    make xconfig || make menuconfig || exit 1
else
    make menuconfig || exit 1
fi

# Poner la CPU en modo rendimiento máximo durante la compilación
if command -v cpupower >/dev/null 2>&1; then
    cpupower frequency-set -g performance >/dev/null 2>&1
fi

# Inicio del cronómetro de compilación
COMIENZO=$(date +%s)

# Compilación del kernel y módulos (LOCALVERSION="" evita el sufijo '+' por cambios locales)
printf "\n%bCompilando kernel y módulos (%s)...%b\n\n" "$CYAN" "$MAKEFLAGS" "$RESET"
if [ -n "$USE_CCACHE" ]; then
    make LOCALVERSION="" CC="ccache gcc" HOSTCC="ccache gcc" all || exit 1
else
    make LOCALVERSION="" all || exit 1
fi

# Obtener versión exacta compilada desde el propio árbol de compilación
KERNEL_VERSION=$(make -s LOCALVERSION="" kernelrelease)
CONTAINER="$HOME/$ESCRITORIO/$MODNAM-$KERNEL_VERSION-$ARCH-$BUILD$TAG"
rm -rf "$CONTAINER"
mkdir -p "$CONTAINER"

# Instalación de módulos y cabeceras en el contenedor (ZSTD_CLEVEL=9 acelera el empaquetado sin apenas aumentar tamaño)
ZSTD_CLEVEL=9 make LOCALVERSION="" modules_install INSTALL_MOD_STRIP=1 INSTALL_MOD_PATH="$CONTAINER" || exit 1
make LOCALVERSION="" INSTALL_HDR_PATH="$CONTAINER/usr" headers_install || exit 1

# Copiar imagen bzImage al escritorio
cp -f "$FUENTES/arch/$KARCH/boot/bzImage" "$HOME/$ESCRITORIO/$VMLINUZ" || exit 1

# Preparar kernel sources ligeros para compilar drivers externos
mv System.map ../
make clean
mv ../System.map .
make LOCALVERSION="" prepare || exit 1
make LOCALVERSION="" scripts || exit 1
cp -f include/generated/* include/linux/ 2>/dev/null

# Limpieza segura de archivos innecesarios en sources
rm -rf Documentation arch/x86/boot/bzImage arch/x86/boot/compressed/vmlinux \
       drivers firmware fs net sound .tmp_versions tools/testing/ vmlinux*

find arch/ -mindepth 1 -maxdepth 1 ! -name "$KARCH" -exec rm -rf {} +
find . -type f -regextype posix-extended \
    -regex '.*\.(a|bin|elf|exe|o|patch|txt|xsl|xz|ko|zst|json|py)$' -delete
find scripts -xtype l -delete
find . \( -type f \( -name ".*" ! -name ".config" -o -name "COPYING" -o -name "CREDITS" \
    -o -name "LICENSE*" -o -name "MAINTAINERS*" -o -name "README*" \) \) -exec rm -rf {} +

find . -type f -perm -u+x -print0 | xargs -0 -r strip --strip-all \
    -R .comment -R .eh_frame -R .eh_frame_hdr -R .eh_frame_ptr \
    -R .jcr -R .note -R .note.ABI-tag -R .note.gnu.build-id \
    -R .note.gnu.gold-version -R .note.GNU-stack >/dev/null 2>&1

# Empaquetado final en módulo .xzm
MODULO_FINAL="$HOME/$ESCRITORIO/$M0DNUM-$MODNAM-$KERNEL_VERSION-$ARCH-$BUILD$TAG.xzm"
FUENTES_BASENAME=$(basename "$FUENTES")

mkdir -p "$CONTAINER/usr/src"
cd /usr/src || exit 1
mv "$FUENTES" "$CONTAINER/usr/src/"
FUENTES=""

# Garantizar enlaces simbólicos válidos build y source dentro del módulo
if [ -d "$CONTAINER/lib/modules/$KERNEL_VERSION" ]; then
    ln -sfn "/usr/src/$FUENTES_BASENAME" "$CONTAINER/lib/modules/$KERNEL_VERSION/build"
    ln -sfn "/usr/src/$FUENTES_BASENAME" "$CONTAINER/lib/modules/$KERNEL_VERSION/source"
fi

printf "\n%bCreando módulo comprimido .xzm ...%b\n" "$CYAN" "$RESET"
if ! dir2xzm "$CONTAINER" "$MODULO_FINAL" -n; then
    printf "\n%bError al crear el módulo %s%b\n" "$ROJO" "$MODULO_FINAL" "$RESET" >&2
    exit 1
fi

rm -rf "$CONTAINER"
CONTAINER=""

# Eliminar el archivo comprimido descargado tras empaquetar con éxito
rm -f "/usr/src/$ARCHIVO_TAR"

# Cálculo exacto del tiempo total empleado
SEGUNDOS_TOTALES=$(( $(date +%s) - COMIENZO ))
HORAS=$(( SEGUNDOS_TOTALES / 3600 ))
MINUTOS=$(( (SEGUNDOS_TOTALES % 3600) / 60 ))
SEGUNDOS=$(( SEGUNDOS_TOTALES % 60 ))
TIEMPO=$(printf "%02d:%02d:%02d" "$HORAS" "$MINUTOS" "$SEGUNDOS")

printf "\n%bTiempo empleado%b: %s%b\n\n" "$AMARILLO" "$BLANCO" "$TIEMPO" "$RESET"

# Si no es Wifislax o está corriendo en modo Live, terminar aquí
if [ ! -f /etc/wifislax-version ] || [ -d /mnt/live ]; then
    printf "%bMódulo guardado en: %b%s%b\n" "$VERDE" "$BLANCO" "$MODULO_FINAL" "$RESET"
    printf "%bKernel guardado en: %b%s/%s/%s%b\n" "$VERDE" "$BLANCO" "$HOME" "$ESCRITORIO" "$VMLINUZ" "$RESET"
    printf "\n%bBye Bye%b\n\n" "$AMARILLO" "$RESET"
    exit 0
fi

# Instalación opcional en Wifislax instalado en disco duro
printf "%bPulsa ENTER para instalar el kernel %s en el sistema o Ctrl+C para salir...%b\n" "$AMARILLO" "$KERNEL_VERSION" "$RESET"
read -r

if [ -f "$MODULO_FINAL" ] && [ -f "$HOME/$ESCRITORIO/$VMLINUZ" ]; then
    printf "\n%bInstalando Kernel %s en el sistema ...%b\n\n" "$VERDE" "$KERNEL_VERSION" "$RESET"
    xzm2dir "$MODULO_FINAL" /
    cp -f "$HOME/$ESCRITORIO/$VMLINUZ" "/boot/vmlinuz-${KERNEL_VERSION}"
    
    if command -v update-grub >/dev/null 2>&1; then
        update-grub
    fi
    printf "\n%bInstalación completada correctamente.%b\n" "$CYAN" "$RESET"
else
    printf "\n%bError: No se encontraron los archivos compilados para instalar.%b\n" "$ROJO" "$RESET" >&2
    exit 1
fi

printf "\n%bBye Bye%b\n\n" "$AMARILLO" "$RESET"
