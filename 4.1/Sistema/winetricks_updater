############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=winetricks
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB="https://github.com/Winetricks/$PRGNAM"
VERSION=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$WEB/releases/latest" | sed -E 's|.*/tag/v?||;s/\r//')
SOURCES="$VERSION.$EXTENSION"
CD="$PRGNAM-$VERSION"
DOWNLOAD="$WEB/archive/refs/tags/$SOURCES"
}

# Comprobar dependencias ( si hay mas de una se separan por un espacio )
F_dependencias(){
DEPENDENCIAS="cabextract wine"
f_dependencias
}

