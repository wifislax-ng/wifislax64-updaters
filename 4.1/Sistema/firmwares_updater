#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261125

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables() {
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
F_variables() {
PRGNAM=firmwares
SRCNAM=linux-firmware
GESTOR=git
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git
VERSION=$(curl -s "$WEB/commit/" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -n 1 | tr -d '-')
SOURCES=$PRGNAM
CD=$SRCNAM
DOWNLOAD=$WEB
}

F_compilar() {
printf '%b\n' "${VERDE}Instalando y filtrando firmwares ...${CIERRE}"
    
# Lista separada por comas de firmwares, prefijos o carpetas extra a conservar siempre
# Se incluye intel/ibt- por defecto porque btintel construye los nombres dinámicamente y no aparecen en modinfo
# Ejemplo ampliado: SALVAR="intel/ibt-,ath9k_htc,mt76,rt2870.bin"
SALVAR="intel/ibt-"

# 1. Instalamos todo en carpeta temporal con compresión zstd
mkdir -p "$PKG/tmp_fw"
ZSTD_CLEVEL=19 make DESTDIR="$PKG/tmp_fw" FIRMWAREDIR=/lib/firmware install-zst

mkdir -p "$PKG/lib/firmware"

# 2. Extraemos la lista única de firmwares (módulos =m, drivers built-in =y y variable SALVAR)
_fc_KVER=$(uname -r)
printf '%b\n' "${VERDE}Filtrando firmwares compatibles con el kernel ${AMARILLO}${_fc_KVER}${VERDE} ...${CIERRE}"

    {
        find "/lib/modules/$_fc_KVER" -type f -name "*.ko*" -print0 2>/dev/null | xargs -0 -r modinfo -F firmware 2>/dev/null
        if [ -f "/lib/modules/$_fc_KVER/modules.builtin.modinfo" ]; then
            tr '\0' '\n' < "/lib/modules/$_fc_KVER/modules.builtin.modinfo" | sed -n 's/^[^=]*\.firmware=//p'
        fi
        if [ -n "$SALVAR" ]; then
            printf '%s\n' "$SALVAR" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
        fi
    } | sort -u | while IFS= read -r _fc_FW; do
        [ -z "$_fc_FW" ] && continue
        _fc_FW_CLEAN="${_fc_FW%%\**}"
        _fc_FW_CLEAN="${_fc_FW_CLEAN%/}"

        for _fc_ITEM in "$PKG/tmp_fw/lib/firmware/${_fc_FW_CLEAN}"*; do
            if [ -e "$_fc_ITEM" ] || [ -L "$_fc_ITEM" ]; then
                _fc_REL="${_fc_ITEM#"$PKG"/tmp_fw/lib/firmware/}"
                _fc_DEST_DIR="$PKG/lib/firmware/$(dirname "$_fc_REL")"
                mkdir -p "$_fc_DEST_DIR"
                cp -a "$_fc_ITEM" "$_fc_DEST_DIR/"
            fi
        done
    done

# 3. Conservamos microcódigos de CPU (Intel y AMD)
    if [ -d "$PKG/tmp_fw/lib/firmware/amd-ucode" ]; then
        cp -a "$PKG/tmp_fw/lib/firmware/amd-ucode" "$PKG/lib/firmware/"
    fi
    if [ -d "$PKG/tmp_fw/lib/firmware/intel-ucode" ]; then
        cp -a "$PKG/tmp_fw/lib/firmware/intel-ucode" "$PKG/lib/firmware/"
    fi

# 4. Reparamos posibles enlaces simbólicos cuyo destino no fue copiado
    find "$PKG/lib/firmware" -type l | while IFS= read -r _fc_LINK; do
        if [ ! -e "$_fc_LINK" ]; then
            _fc_REL_PATH="${_fc_LINK#"$PKG"/lib/firmware/}"
            _fc_ORIG_TARGET=$(readlink -f "$PKG/tmp_fw/lib/firmware/$_fc_REL_PATH" 2>/dev/null || true)
            if [ -n "$_fc_ORIG_TARGET" ] && [ -e "$_fc_ORIG_TARGET" ]; then
                _fc_TARGET="${_fc_ORIG_TARGET#"$PKG"/tmp_fw/lib/firmware/}"
                mkdir -p "$PKG/lib/firmware/$(dirname "$_fc_TARGET")"
                cp -a "$_fc_ORIG_TARGET" "$PKG/lib/firmware/$_fc_TARGET"
                if [ ! -e "$_fc_LINK" ]; then
                    cp -af "$_fc_ORIG_TARGET" "$_fc_LINK"
                fi
            fi
        fi
    done

# 5. Generamos imágenes initrd de microcódigo para /boot (en carpetas separadas)
    if [ -d "$PKG/lib/firmware/amd-ucode" ]; then
        mkdir -p "$PKG/boot/tmp_amd/kernel/x86/microcode"
        (
            cd "$PKG/boot/tmp_amd" || exit 1
            find "$PKG/lib/firmware/amd-ucode" -type f \( -name "*.zst" -o -name "*.bin" \) | sort | while IFS= read -r _fc_f; do
                case "$_fc_f" in
                    *.zst) zstdcat "$_fc_f" || exit 1 ;;
                    *)     cat "$_fc_f" || exit 1 ;;
                esac
            done > kernel/x86/microcode/AuthenticAMD.bin

            if [ -s kernel/x86/microcode/AuthenticAMD.bin ]; then
                find . | cpio --no-absolute-filenames -H newc -o -F "$PKG/boot/amd-ucode.img" 2>/dev/null
            fi
        ) || exit 1
    fi

    if [ -d "$PKG/lib/firmware/intel-ucode" ]; then
        mkdir -p "$PKG/boot/tmp_intel/kernel/x86/microcode"
        (
            cd "$PKG/boot/tmp_intel" || exit 1
            find "$PKG/lib/firmware/intel-ucode" -type f -name "[0-9a-f][0-9a-f]-*" | sort | while IFS= read -r _fc_f; do
                case "$_fc_f" in
                    *.zst) zstdcat "$_fc_f" || exit 1 ;;
                    *)     cat "$_fc_f" || exit 1 ;;
                esac
            done > kernel/x86/microcode/GenuineIntel.bin

            if [ -s kernel/x86/microcode/GenuineIntel.bin ]; then
                find . | cpio --no-absolute-filenames -H newc -o -F "$PKG/boot/intel-ucode.img" 2>/dev/null
            fi
        ) || exit 1
    fi

# 6. Limpiamos temporales
rm -rf "$PKG/boot/tmp_amd" "$PKG/boot/tmp_intel" "$PKG/tmp_fw"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura noarch
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Creamos directorio temporal de trabajo
f_directorioTemporal
# 9. Descargamos sources
f_download
# 10. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 11. Configuramos y compilamos
F_compilar
# 12. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
