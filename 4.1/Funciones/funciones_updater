#!/bin/sh

# Script by www.seguridadwireless.net (Optimizado y compatible con POSIX)

FUNCIONES_VERSION=20261121

# Colores (con fallback seguro si no hay TTY)
if [ -t 1 ]; then
    CIERRE=$(tput sgr0 2>/dev/null || true)
    ROJO=$(tput setaf 9 2>/dev/null || true)
    VERDE=$(tput setaf 10 2>/dev/null || true)
    CYAN=$(tput setaf 14 2>/dev/null || true)
    AMARILLO=$(tput setaf 11 2>/dev/null || true)
    BLANCO=$(tput setaf 15 2>/dev/null || true)
    ROSA=$(tput setaf 13 2>/dev/null || true)
else
    CIERRE=""
    ROJO=""
    VERDE=""
    CYAN=""
    AMARILLO=""
    BLANCO=""
    ROSA=""
fi

# Variables globales
PRGNAM=${PRGNAM:-funciones}
VERSION=${VERSION:-$FUNCIONES_VERSION}
BUILD=${BUILD:-1}
TAG=${TAG:-wifislax}
CWD=$(pwd)

# Lectura limpia de configuración del sistema
if [ -f /root/.config/user-dirs.dirs ]; then
    ESCRITORIO=$(awk -F'"' '/XDG_DESKTOP_DIR/{split($2,a,"/"); print a[2]}' /root/.config/user-dirs.dirs)
fi
ESCRITORIO=${ESCRITORIO:-Desktop}

WIFISLAX=$(awk -F'[ -]' 'NR==1{print $2}' /etc/wifislax-version 2>/dev/null || true)

CONFIG="/etc/wifislax-updaters/wifislax-updaters.conf"
if [ -z "$PACKAGETYPE" ] && [ -f "$CONFIG" ]; then
    PACKAGETYPE=$(awk -F'=' '/^PACKAGETYPE=/{print $2}' "$CONFIG")
fi
PACKAGETYPE=${PACKAGETYPE:-xzm}

# Variables de compilación e idioma
export MAKEFLAGS="-j$(nproc 2>/dev/null || echo 1)"
export PYTHON3=yes
_lang_base="${LANG%%_*}"
case "$_lang_base" in
    ""|C|POSIX) export IDIOMA="es" ;;
    *) export IDIOMA="$_lang_base" ;;
esac

# Eliminamos posibles ficheros viejos de respaldo (~)
rm -f /opt/wifislax-updaters/*/*~ 2>/dev/null || true

# Función auxiliar para formatear fechas AAAAMMDD a DD/MM/AAAA en POSIX
_format_fecha_posix() {
    _ff_val="$1"
    _ff_anio=$(printf '%s' "$_ff_val" | cut -c1-4)
    _ff_mes=$(printf '%s' "$_ff_val" | cut -c5-6)
    _ff_dia=$(printf '%s' "$_ff_val" | cut -c7-8)
    printf '%s/%s/%s' "$_ff_dia" "$_ff_mes" "$_ff_anio"
}

# Función de limpieza unificada (EXIT captura salidas normales, errores y señales)
f_exitmode() {
    _em_code=$?
    if [ -n "$TMP" ] && [ -d "$TMP" ]; then
        rm -rf -- "$TMP"
    fi
    exit "$_em_code"
}
trap f_exitmode EXIT INT TERM HUP

# Función que muestra Presentación
f_presentacion() {
    clear
    printf '\n\n'
    for _p_linea in \
        "${BLANCO}       ******************************" \
        "${VERDE}          Actualizador/Instalador    " \
        "${VERDE}          Paquete: ${AMARILLO}${PRGNAM}" \
        "${VERDE}                                   " \
        "${VERDE}          www.seguridadwireless.net  " \
        "${BLANCO}       ******************************${CIERRE}"
    do
        sleep 0.08 2>/dev/null || true
        printf '%s\n' "$_p_linea"
    done
    printf '\n'
}

# Comprobar conexión (usando timeout corto y ping)
f_comprobarConexion() {
    if ! ping -c1 -W3 google.com >/dev/null 2>&1 && ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
        printf '\n%bNo hay conexión a internet... el script se cerrará.%b\n\n' "$BLANCO" "$CIERRE"
        exit 1
    fi
}

# Comprobación de updates para el script (descarga atómica y segura)
f_comprobarUpdates() {
    _cu_servidor_web="https://raw.githubusercontent.com/wifislax-ng/wifislax64-updaters/master/${WIFISLAX}"
    _cu_ruta_updater=$(find /opt/wifislax-updaters -maxdepth 3 -type f -name "${PRGNAM}_updater" -print -quit)

    [ -z "$_cu_ruta_updater" ] && return 0

    _cu_directorio="${_cu_ruta_updater%/*}"
    _cu_categoria_dir="${_cu_directorio##*/}"
    _cu_url_script="${_cu_servidor_web}/${_cu_categoria_dir}/${PRGNAM}_updater"

    _cu_local_ver=$(printf '%s' "$SCRIPT_VERSION" | tr -cd '0-9')
    _cu_sv_dia=$(printf '%s' "$_cu_local_ver" | cut -c7-8)
    _cu_sv_mes=$(printf '%s' "$_cu_local_ver" | cut -c5-6)
    _cu_sv_anio=$(printf '%s' "$_cu_local_ver" | cut -c1-4)
    printf '%bVersión Script%b: %b%s%b/%b%s%b/%b%s%b\n' \
        "$CYAN" "$CIERRE" "$ROJO" "$_cu_sv_dia" "$BLANCO" "$AMARILLO" "$_cu_sv_mes" "$BLANCO" "$ROJO" "$_cu_sv_anio" "$CIERRE"

    _cu_srv_ver=$(curl -sL --connect-timeout 5 --max-time 10 "$_cu_url_script" 2>/dev/null | awk -F'=' '/^SCRIPT_VERSION=/{print $2; exit}' | tr -cd '0-9' || true)

    if [ -n "$_cu_local_ver" ] && [ -n "$_cu_srv_ver" ] && [ "$_cu_local_ver" -lt "$_cu_srv_ver" ]; then
        _cu_srv_dia=$(printf '%s' "$_cu_srv_ver" | cut -c7-8)
        _cu_srv_mes=$(printf '%s' "$_cu_srv_ver" | cut -c5-6)
        _cu_srv_anio=$(printf '%s' "$_cu_srv_ver" | cut -c1-4)

        printf '\n%bComprobando si hay actualizaciones para el script...%b\n' "$ROSA" "$CIERRE"
        printf '%bNUEVA VERSIÓN DISPONIBLE%b\n\n' "$ROJO" "$CIERRE"
        printf '%bVersión Server%b: %b%s%b/%b%s%b/%b%s%b\n\n' \
            "$ROSA" "$CIERRE" "$ROJO" "$_cu_srv_dia" "$BLANCO" "$AMARILLO" "$_cu_srv_mes" "$BLANCO" "$ROJO" "$_cu_srv_anio" "$CIERRE"
        printf '%bActualizando %s_updater...%b\n' "$CYAN" "$PRGNAM" "$CIERRE"

        if curl -fsSL --connect-timeout 5 --max-time 15 "$_cu_url_script" -o "${_cu_ruta_updater}.tmp" && [ -s "${_cu_ruta_updater}.tmp" ]; then
            chmod +x "${_cu_ruta_updater}.tmp"
            mv -f "${_cu_ruta_updater}.tmp" "$_cu_ruta_updater"
            printf '%bLISTO. Reiniciando script...%b\n\n' "$VERDE" "$CIERRE"
            TMP=""
            exec "$_cu_ruta_updater" "$@"
        else
            rm -f "${_cu_ruta_updater}.tmp"
            printf '%bError al descargar la actualización. Continuando con la versión actual.%b\n\n' "$ROJO" "$CIERRE"
        fi
    fi
}

# Definimos arquitectura del sistema
f_arquitectura() {
    ARCH="${1:-$(uname -m)}"
    case "$ARCH" in
        i?86)
            ARCH="i586"
            SLKCFLAGS="-O2 -march=i586 -mtune=i686"
            LIBDIRSUFFIX=""
            ;;
        arm*)
            ARCH="arm"
            SLKCFLAGS="-O2"
            LIBDIRSUFFIX=""
            ;;
        x86_64)
            SLKCFLAGS="-O2 -fPIC"
            LIBDIRSUFFIX="64"
            ;;
        *)
            SLKCFLAGS="-O2"
            LIBDIRSUFFIX=""
            ;;
    esac
}

# Helper interno para obtener el nombre completo del paquete instalado en Slackware
_get_installed_pkg() {
    _gip_pkg_name="$1"
    for _gip_f in /var/lib/pkgtools/packages/"${_gip_pkg_name}"-*; do
        [ -e "$_gip_f" ] || continue
        _gip_base="${_gip_f##*/}"
        case "$_gip_base" in
            "${_gip_pkg_name}"-[0-9]*)
                _gip_rest="${_gip_base#"${_gip_pkg_name}-"}"
                _gip_without_build="${_gip_rest%-*}"
                _gip_without_arch="${_gip_without_build%-*}"
                if [ -n "$_gip_without_arch" ] && [ "$_gip_without_arch" != "$_gip_rest" ]; then
                    printf '%s\n' "$_gip_base"
                    return 0
                fi
                ;;
        esac
    done
    return 1
}

# Detecta la versión instalada en el sistema
f_versionInstalada() {
    _vi_pkg_full=$(_get_installed_pkg "$PRGNAM" || true)

    if [ -z "$_vi_pkg_full" ]; then
        INSTALADA="NO INSTALADA"
        VERSIONLOCAL="$INSTALADA"
    else
        _vi_rest="${_vi_pkg_full#"${PRGNAM}-"}"
        _vi_sin_build="${_vi_rest%-*}"
        INSTALADA="${_vi_sin_build%-*}"
        VERSIONLOCAL="${PRGNAM}-${INSTALADA}"
    fi

    printf '\n%bLa versión del sistema es... %b%s%b\n' "$AMARILLO" "$CYAN" "$VERSIONLOCAL" "$CIERRE"
    printf '\n__________________________________________\n\n'
    printf '%bLa versión más nueva en su página web es... %b%s-%s%b\n\n' "$AMARILLO" "$CYAN" "$PRGNAM" "$VERSION" "$CIERRE"

    if [ "$PRGNAM" = "x265" ]; then
        printf '%bADVERTENCIA:\n' "$ROJO"
        printf '%bActualizar este paquete puede romper %bffmpeg\n' "$BLANCO" "$AMARILLO"
        printf '%bEs posible que necesites recompilar %bffmpeg%b\n\n' "$BLANCO" "$AMARILLO" "$CIERRE"
    fi

    printf '%bPulsa %bENTER%b si deseas actualizarla (o Ctrl+C para salir)%b\n' "$BLANCO" "$ROJO" "$BLANCO" "$CIERRE"
    read -r _vi_dummy

    # Si el paquete está instalado y es la misma versión, subimos el número de build
    if [ "$INSTALADA" = "$VERSION" ] && [ -n "$_vi_pkg_full" ]; then
        _vi_build_tag="${_vi_pkg_full##*-}"
        _vi_buildlocal=$(printf '%s' "$_vi_build_tag" | tr -cd '0-9')
        BUILD=$(( ${_vi_buildlocal:-0} + 1 ))
    fi

    COMIENZO=$(date +%s)
}

# Resolución de dependencias
f_dependencias() {
    [ -z "$DEPENDENCIAS" ] && return 0
    printf '%bComprobando dependencias ...%b\n\n' "$ROSA" "$CIERRE"

    for _dep_d in $DEPENDENCIAS; do
        if command -v "$_dep_d" >/dev/null 2>&1 || _get_installed_pkg "$_dep_d" >/dev/null; then
            printf '%bDependencia %b%s %bINSTALADA%b.\n' "$BLANCO" "$AMARILLO" "$_dep_d" "$VERDE" "$CIERRE"
            continue
        fi

        printf '%bDependencia %b%s %bNO INSTALADA%b ...resolviendo%b.\n' "$BLANCO" "$AMARILLO" "$_dep_d" "$ROJO" "$BLANCO" "$CIERRE"
        _dep_updater=$(find /opt/wifislax-updaters -maxdepth 3 -type f -name "${_dep_d}_updater" -print -quit)

        if [ -z "$_dep_updater" ]; then
            if ping -c1 -W3 www.slackbuilds.org >/dev/null 2>&1; then
                slapt-src -u >/dev/null 2>&1
            else
                printf '\n%bParece que slackbuilds.org no responde ... inténtalo más tarde%b\n\n' "$ROJO" "$CIERRE"
                exit 1
            fi

            if [ "$_dep_d" = "pylast" ]; then
                xterm -e sh -c "TAG=slackbuilds PYTHON3=no slapt-src -y -n -i ${_dep_d}"
            else
                xterm -e sh -c "TAG=slackbuilds slapt-src -y -n -i ${_dep_d}"
            fi

            _dep_packdir=$(find /usr/src/slapt-src/ -type f -name "${_dep_d}-*.txz" -print -quit)
            _dep_xzmpack=""
            _dep_group=""
            if [ -n "$_dep_packdir" ]; then
                _dep_xzmpack="${_dep_packdir##*/}"
                _dep_xzmpack="${_dep_xzmpack%.txz}.xzm"
                _dep_group=$(printf '%s\n' "$_dep_packdir" | awk -F'/' '{print $(NF-2)}')

                if [ "$PACKAGETYPE" != "disable" ]; then
                    mkdir -p "${HOME}/${ESCRITORIO}/${PRGNAM}_depends/${_dep_group}"
                fi
            fi

            if ! command -v "$_dep_d" >/dev/null 2>&1 && ! _get_installed_pkg "$_dep_d" >/dev/null; then
                printf '\n%bNo se pudo resolver la dependencia %b%s%b.\n\n' "$ROJO" "$AMARILLO" "$_dep_d" "$CIERRE"
                exit 1
            fi

            if [ "$PACKAGETYPE" = "txz" ] && [ -n "$_dep_packdir" ]; then
                mv -f "$_dep_packdir" "${HOME}/${ESCRITORIO}/${PRGNAM}_depends/${_dep_group}/"
            elif [ "$PACKAGETYPE" = "xzm" ] && [ -n "$_dep_packdir" ]; then
                xterm -e sh -c "txz2xzm \"$_dep_packdir\" \"${HOME}/${ESCRITORIO}/${PRGNAM}_depends/${_dep_group}/${_dep_xzmpack}\""
            fi

            if [ -n "$_dep_group" ]; then
                rm -rf "/usr/src/slapt-src/${_dep_group}/${_dep_d}"
            fi
            find /usr/src/slapt-src -empty -type d -delete 2>/dev/null || true
            printf '%bDependencia %b%s %bRESUELTA%b.\n' "$BLANCO" "$AMARILLO" "$_dep_d" "$CYAN" "$CIERRE"
        else
            xterm -e sh -c "yes y | \"$_dep_updater\""
            if ! command -v "$_dep_d" >/dev/null 2>&1 && ! _get_installed_pkg "$_dep_d" >/dev/null; then
                printf '\n%bNo se pudo resolver la dependencia %b%s%b.\n\n' "$ROJO" "$AMARILLO" "$_dep_d" "$CIERRE"
                exit 1
            fi
            printf '%bDependencia %b%s %bRESUELTA%b.\n' "$BLANCO" "$AMARILLO" "$_dep_d" "$CYAN" "$CIERRE"
        fi
    done
}

# Elimina una versión anterior
f_elimina() {
    if [ "$PRGNAM" = "xampp" ] && [ -x /opt/lampp/lampp ]; then
        /opt/lampp/lampp stop >/dev/null 2>&1 || true
    fi

    _el_pkg_full=$(_get_installed_pkg "$PRGNAM" || true)
    if [ -n "$_el_pkg_full" ]; then
        printf '\n%bEliminando la versión del sistema (%s)...%b\n' "$ROJO" "$_el_pkg_full" "$CIERRE"
        removepkg "$_el_pkg_full"
    fi
}

# Crea el directorio temporal de trabajo
f_directorioTemporal() {
    TMP=${TMP:-/tmp/build/$PRGNAM}
    PKG="$TMP/package-$PRGNAM"
    OUTPUT=${OUTPUT:-/tmp}

    if [ "$GESTOR" = "git" ]; then
        rm -rf -- "$TMP"
    fi
    rm -rf -- "$PKG"
    mkdir -p "$TMP" "$PKG" "$OUTPUT"
    cd "$TMP" || exit 1
}

# Hace strip al paquete
f_strip() {
    cd "$PKG" || return 1
    stripdir "$PKG" 2>/dev/null || true
}

# Descargar sources
f_download() {
    _dl_args=""
    case "$GESTOR" in
        wget) _dl_args="-N -L -c -q --show-progress --no-passive-ftp" ;;
        curl) _dl_args="-fL --progress-bar" ;;
        git)  _dl_args="clone --depth 1 --single-branch" ;;
    esac

    if [ ! -s "$SOURCES" ]; then
        rm -f "$SOURCES"
        printf '\n%bDescargando sources de %s-%s%b\n' "$CYAN" "$PRGNAM" "$VERSION" "$CIERRE"
        printf '%b' "$ROSA"
        case "$GESTOR" in
            curl)
                if ! curl $_dl_args -o "$SOURCES" "$DOWNLOAD" || [ ! -s "$SOURCES" ]; then
                    rm -f "$SOURCES"
                    printf '%b' "$CIERRE"
                    exit 1
                fi
                ;;
            *)
                case "$DOWNLOAD" in
                    */download|*/download\?*)
                        if ! wget -L -c -q --show-progress --no-passive-ftp -O "$SOURCES" "$DOWNLOAD" || [ ! -s "$SOURCES" ]; then
                            rm -f "$SOURCES"
                            printf '%b' "$CIERRE"
                            exit 1
                        fi
                        ;;
                    *)
                        # shellcheck disable=SC2086
                        if ! $GESTOR $_dl_args "$DOWNLOAD"; then
                            printf '%b' "$CIERRE"
                            exit 1
                        fi
                        ;;
                esac
                ;;
        esac
        printf '%b' "$CIERRE"
    fi
}

# Preparamos entorno
f_descomprimir() {
    printf '\n%bDescomprimiendo ...%b\n\n' "$VERDE" "$CIERRE"
    sleep 1
    rm -rf -- "${PRGNAM}-${VERSION}"

    if [ "$EXTENSION" = "zip" ]; then
        unzip -q "$SOURCES" || exit 1
    elif [ "$EXTENSION" = "7z" ]; then
        7z x -y "$SOURCES" || exit 1
    else
        if [ -f "$SOURCES" ]; then
            tar xfv "$SOURCES" || exit 1
        elif [ -f "${SRCNAM}-${VERSION}.${EXTENSION}" ]; then
            tar xfv "${SRCNAM}-${VERSION}.${EXTENSION}" || exit 1
        elif [ -f "${PRGNAM}-src-${VERSION}.${EXTENSION}" ]; then
            tar xfv "${PRGNAM}-src-${VERSION}.${EXTENSION}" || exit 1
        else
            printf '%bError: No se encontró el archivo comprimido.%b\n' "$ROJO" "$CIERRE"
            exit 1
        fi
    fi
}

f_cd() {
    if [ -z "$CD" ]; then
        printf '\n%bLa variable CD no existe o está vacía.%b\n\n' "$ROJO" "$CIERRE"
        exit 1
    fi

    _cd_target=""
    if [ -d "$TMP/$CD" ]; then
        _cd_target="$TMP/$CD"
    else
        for _cd_match in "$TMP"/$CD; do
            if [ -d "$_cd_match" ]; then
                _cd_target="$_cd_match"
                break
            fi
        done
    fi

    if [ -z "$_cd_target" ] || ! cd "$_cd_target"; then
        printf '%bError al entrar en el directorio %s/%s.%b\n' "$ROJO" "$TMP" "$CD" "$CIERRE"
        exit 1
    fi

    chown -R root:root .
    find -L . \
        \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) -exec chmod 755 {} + -o \
        \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} +
}

f_categoria() {
    cd .. || return 1
    _cat_ruta_updater=$(find /opt/wifislax-updaters -maxdepth 3 -type f -name "${PRGNAM}_updater" -print -quit)
    CATEGORIA=$(printf '%s\n' "$_cat_ruta_updater" | awk -F'/' '{print $4}')
    CATEGORIA=${CATEGORIA:-otros}
    mkdir -p "${HOME}/${ESCRITORIO}/${CATEGORIA}"
}

f_xzm() {
    printf '\n%bInstalando y creando módulo %bxzm ...%b\n' "$VERDE" "$AMARILLO" "$CIERRE"
    sleep 1
    f_categoria

    _xzm_destino="${HOME}/${ESCRITORIO}/${CATEGORIA}/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.xzm"
    cleandir "$PKG" >/dev/null 2>&1 || true
    dir2xzm "$PKG" "$_xzm_destino"
    xzm2dir "$_xzm_destino" /
}

f_txz() {
    printf '\n%bInstalando y creando paquete %btxz ...%b\n' "$VERDE" "$AMARILLO" "$CIERRE"
    sleep 1
    f_categoria

    # Variables de búsqueda para slack-desc
    if [ -f /etc/wifislax-updaters/SLACKBUILDS.TXT ] && ping -c1 -W3 www.slackbuilds.org >/dev/null 2>&1; then
        _txz_slackweb="https://slackbuilds.org"
        _txz_slackver=$(curl -sL "$_txz_slackweb/" 2>/dev/null | awk -F'/' '/repository\/[0-9]/ && !v {v=$3} END{print v}' || true)
        _txz_section=$(awk -F'/' -v pkg="$PRGNAM" '/LOCATION/ && $NF==pkg {print $(NF-1); exit}' /etc/wifislax-updaters/SLACKBUILDS.TXT || true)
        if [ -n "$_txz_section" ] && [ -n "$_txz_slackver" ]; then
            _txz_desc=$(curl -sL "${_txz_slackweb}/slackbuilds/${_txz_slackver}/${_txz_section}/${PRGNAM}/slack-desc" 2>/dev/null || true)
            if [ -n "$_txz_desc" ]; then
                mkdir -p "$PKG/install"
                printf '%s\n' "$_txz_desc" > "$PKG/install/slack-desc"
            fi
        fi
    fi

    _txz_destino="${HOME}/${ESCRITORIO}/${CATEGORIA}/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.txz"
    cd "$PKG" || exit 1
    cleandir "$PKG" >/dev/null 2>&1 || true
    /sbin/makepkg -l y -c n "$_txz_destino"
    installpkg "$_txz_destino"
}

f_disable() {
    printf '\n%bInstalando ...%b\n' "$VERDE" "$CIERRE"
    sleep 1

    _dis_tmp_pkg="/tmp/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.txz"
    cd "$PKG" || exit 1
    cleandir "$PKG" >/dev/null 2>&1 || true
    /sbin/makepkg -l y -c n "$_dis_tmp_pkg"
    installpkg "$_dis_tmp_pkg"
    rm -f "$_dis_tmp_pkg"
}

# Creamos paquete, instalamos y salimos
f_tareasFinales() {
    if [ "$INSTALADA" != "NO INSTALADA" ]; then
        f_elimina
    fi

    case "$PACKAGETYPE" in
        xzm) f_xzm ;;
        txz) f_txz ;;
        *)   f_disable ;;
    esac

    clear
    printf '%bActualizando sistema%b...%b\n' "$VERDE" "$BLANCO" "$CIERRE"
    cacheupdater || true

    if [ "$PRGNAM" = "teamviewer" ] && [ -x /etc/rc.d/rc.teamviewerd ]; then
        /etc/rc.d/rc.teamviewerd start >/dev/null 2>&1 || true
    fi

    clear
    if [ "$PACKAGETYPE" = "disable" ]; then
        printf '%bInstalado paquete %b%s-%s%b\n\n' "$VERDE" "$AMARILLO" "$PRGNAM" "$VERSION" "$CIERRE"
    else
        printf '%bInstalado y Creado paquete %b%s-%s%b\n\n' "$VERDE" "$AMARILLO" "$PRGNAM" "$VERSION" "$CIERRE"
    fi

    _tf_ahora=$(date +%s)
    _tf_diff=$(( _tf_ahora - COMIENZO ))
    _tf_tiempo=$(date -u -d @"$_tf_diff" +%H:%M:%S)

    printf '%bTiempo empleado%b: %s\n\n' "$AMARILLO" "$BLANCO" "$_tf_tiempo"
    printf '%bBye Bye%b\n\n' "$VERDE" "$CIERRE"

    rm -rf -- "$TMP" >/dev/null 2>&1 || true
    TMP=""
    exit 0
}
