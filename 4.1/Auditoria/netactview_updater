# Definicion de variables
F_variables() {
PRGNAM=netactview
EXTENSION=tar.bz2
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://sourceforge.net/projects/${PRGNAM}/files/${PRGNAM}
VERSION=$(curl -sL --connect-timeout 15 "https://sourceforge.net/projects/${PRGNAM}/rss?path=/${PRGNAM}" | sed -n "s|.*${PRGNAM}-\([0-9][0-9.]*\)/${PRGNAM}-.*|\1|p" | head -1)
SOURCES=$PRGNAM-$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/$PRGNAM-$VERSION/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="libgtop gtk+2 libglade"
f_dependencias
}

