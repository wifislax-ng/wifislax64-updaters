SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=pixiewps
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://github.com/wiire-a/$PRGNAM
VERSION=$(curl -sL --connect-timeout 15 "$WEB/tags" | sed -n "s/.*v\([0-9][0-9.]*\)\.$EXTENSION.*/\1/p" | head -1)
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/archive/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="openssl"
f_dependencias
}

# Compilamos
F_compilar(){
echo
echo "${VERDE}Compilando ...${CIERRE}"
make -j"$(nproc 2>/dev/null || echo 1)" OPENSSL=1 || exit 1
make DESTDIR="${PKG}" PREFIX=/usr install || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
