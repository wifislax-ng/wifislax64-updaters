#!/bin/bash

SCRIPTVERSION=2.0

# v2.0 Aislamiento puro de la funcion F_variables() sin ejecutar funciones_updater, deteccion de HTML/basura en VERSION y reporte exacto por archivo
# v1.8 Ejecucion paralela (10 hilos), deteccion real de fallos bajo set -e, alineacion exacta de columnas y estadisticas finales
# v1.7 Excluye correctamente funciones_updater en los bucles de modificacion y ejecucion
# v1.6 Soporte para estructura /opt/wifislax-updaters/categoria/archivo_updater, ajuste de rutas relativas a funciones_updater y salida limpia si no hay scripts
# v1.5 Copia funciones_updater al entorno temporal, busqueda insensible a mayusculas para f_exitmode, soporte *_updater* y aumento de timeout a 15s
# v1.4 Implementacion de colores con tput, limpieza automatica con trap y optimizacion general
# v1.2 Se añade funcion timeout
# v1.1 Se añade mensaje si todos los updaters funcionan

readonly DIR_ORIGEN="/opt/wifislax-updaters"
readonly TMP="/tmp/Updaters_Test"
readonly TIMEOUT_SEG=15
readonly HILOS=10

# Configuracion portable de colores mediante tput
if [[ -t 1 ]] && command -v tput &>/dev/null && [[ $(tput colors 2>/dev/null || echo 0) -ge 8 ]]; then
  CIERRE=$(tput sgr0)
  ROJO=$(tput bold; tput setaf 1)
  VERDE=$(tput bold; tput setaf 2)
  AMARILLO=$(tput bold; tput setaf 3)
  CYAN=$(tput bold; tput setaf 6)
  BLANCO=$(tput bold; tput setaf 7)
else
  CIERRE=""
  ROJO=""
  VERDE=""
  AMARILLO=""
  CYAN=""
  BLANCO=""
fi

export CIERRE ROJO VERDE AMARILLO CYAN BLANCO TMP TIMEOUT_SEG

# Asegura que el directorio temporal se borre y se restaure el color incluso si pulsas Ctrl+C
trap 'rm -rf "$TMP"; printf "%s" "$CIERRE"' EXIT

clear

# Configuracion de arquitectura (algunas URLs en F_variables usan $ARCH o $LIBDIRSUFFIX)
if [[ -z "$ARCH" ]]; then
  case "$(uname -m)" in
    i?86) ARCH="i586" ;;
    arm*) ARCH="arm" ;;
       *) ARCH="$(uname -m)" ;;
  esac
fi

case "$ARCH" in
  i586)   LIBDIRSUFFIX="" ;;
  i686)   LIBDIRSUFFIX="" ;;
  x86_64) LIBDIRSUFFIX="64" ;;
  *)      LIBDIRSUFFIX="" ;;
esac

export ARCH LIBDIRSUFFIX

echo "#############################"
echo "###  ${CYAN}TESTER DE UPDATERS${CIERRE} ###"
echo "#############################"

# Comprobacion rapida de internet (2 segundos maximo de espera)
if ! ping -c 1 -W 2 8.8.8.8 &>/dev/null; then
  echo ""
  echo "${ROJO}No hay conexion a internet... el script se cerrara.${CIERRE}"
  echo ""
  exit 1
fi

BUSQUEDA() {
  rm -rf "$TMP"
  mkdir -p "$TMP"
  touch "$TMP/CORRECTOS" "$TMP/FALLIDOS"

  if [[ ! -d "$DIR_ORIGEN" ]]; then
    echo "${ROJO}Error: No existe el directorio $DIR_ORIGEN${CIERRE}"
    exit 1
  fi

  echo ""
  echo "${BLANCO}[${VERDE}*${BLANCO}]${AMARILLO} Buscando updaters y aislando F_variables()...${CIERRE}"

  # Busca en las subcarpetas de categorias (/categoria/archivo_updater) y los copia a $TMP
  find "$DIR_ORIGEN" -mindepth 2 -maxdepth 2 -type f -name "*_updater*"     ! -name "linux*"     ! -name "funciones_updater*"     ! -name "wifislax-updaters_updater*"     ! -name "firefox_multi_updater*"     -exec cp -t "$TMP" {} + 2>/dev/null
}

TEMPORAL() {
  shopt -s nullglob
  local updaters=("$TMP"/*_updater*)
  shopt -u nullglob

  if [[ ${#updaters[@]} -eq 0 ]]; then
    echo "${ROJO}Aviso: No se encontraron scripts de actualizacion en $DIR_ORIGEN${CIERRE}"
    exit 1
  fi

  for UPDATER in "${updaters[@]}"; do
    local ARCHIVO_ORIG
    ARCHIVO_ORIG=$(basename "$UPDATER")
    [[ "$ARCHIVO_ORIG" == funciones_updater* ]] && continue

    # Extrae UNICAMENTE el bloque de la funcion F_variables() usando awk contando llaves
    awk '
      BEGIN { in_func=0; depth=0 }
      /^[[:space:]]*F_variables[[:space:]]*\(\)/ { in_func=1 }
      in_func {
        print
        for (i=1; i<=length($0); i++) {
          c = substr($0, i, 1)
          if (c == "{") depth++
          else if (c == "}") depth--
        }
        if (depth == 0 && /}/) exit
      }
    ' "$UPDATER" > "${UPDATER}.isolated"

    cat << EOF > "$UPDATER"
#!/bin/bash
ARCHIVO_ORIG="$ARCHIVO_ORIG"
$(cat "${UPDATER}.isolated")

if declare -F F_variables >/dev/null; then
  F_variables >/dev/null 2>&1
fi

NOMBRE_SHOW="\${PRGNAM:-\${ARCHIVO_ORIG%%_updater*}}"

# Valida que VERSION no este vacia ni contenga HTML, saltos de linea o espacios
if [[ -z "\$VERSION" ]] || [[ "\$VERSION" == *"<"* ]] || [[ "\$VERSION" == *">"* ]] || [[ "\$VERSION" =~ [[:space:]] ]]; then
  echo "\$NOMBRE_SHOW (\$ARCHIVO_ORIG)" >> "\$TMP/FALLIDOS"
  printf "\${BLANCO}Programa: \${CYAN}%-28s \${BLANCO}Version: \${ROJO}Fallido\${CIERRE}
" "\$NOMBRE_SHOW"
else
  echo "\$NOMBRE_SHOW" >> "\$TMP/CORRECTOS"
  printf "\${BLANCO}Programa: \${CYAN}%-28s \${BLANCO}Version: \${VERDE}%s\${CIERRE}
" "\$NOMBRE_SHOW" "\$VERSION"
fi
EOF
    rm -f "${UPDATER}.isolated"
  done
}

TEST_UNO() {
  local UPDATER="$1"
  local NOMBRE_LIMPIO
  NOMBRE_LIMPIO=$(basename "$UPDATER" | sed 's/_updater.*//')

  timeout -s SIGTERM "$TIMEOUT_SEG" bash "$UPDATER"
  local RC=$?

  if [[ $RC -eq 124 ]]; then
    printf "${BLANCO}Programa: ${CYAN}%-28s ${BLANCO}Version: ${ROJO}TIMEOUT${CIERRE}
" "$NOMBRE_LIMPIO"
    echo "$NOMBRE_LIMPIO ($(basename "$UPDATER") - TIMEOUT)" >> "$TMP/FALLIDOS"
  elif [[ $RC -ne 0 ]]; then
    printf "${BLANCO}Programa: ${CYAN}%-28s ${BLANCO}Version: ${ROJO}Error (exit $RC)${CIERRE}
" "$NOMBRE_LIMPIO"
    echo "$NOMBRE_LIMPIO ($(basename "$UPDATER") - Error exit $RC)" >> "$TMP/FALLIDOS"
  fi
}
export -f TEST_UNO

MOSTRAR() {
  echo "${BLANCO}[${VERDE}*${BLANCO}]${AMARILLO} Testeando F_variables() en $HILOS hilos...${CIERRE}"
  echo ""

  cd "$TMP" || exit 1

  find . -maxdepth 1 -type f -name "*_updater*" ! -name "funciones_updater*" | sort |     xargs -r -n 1 -P "$HILOS" bash -c 'TEST_UNO "$@"' _
}

INFORME() {
  local TOTAL_OK=0
  local TOTAL_FAIL=0
  [[ -s "$TMP/CORRECTOS" ]] && TOTAL_OK=$(sort -u "$TMP/CORRECTOS" | wc -l)
  [[ -s "$TMP/FALLIDOS" ]] && TOTAL_FAIL=$(sort -u "$TMP/FALLIDOS" | wc -l)
  local TOTAL=$((TOTAL_OK + TOTAL_FAIL))

  echo ""
  echo "#############################"
  echo "###  ${ROJO}INFORME DE ERRORES${CIERRE} ###"
  echo "#############################"
  echo ""
  echo "${BLANCO}[${VERDE}*${BLANCO}] Testeados: ${CYAN}$TOTAL${BLANCO} | Correctos: ${VERDE}$TOTAL_OK${BLANCO} | Fallidos: ${ROJO}$TOTAL_FAIL${BLANCO} (${AMARILLO}${SECONDS}s${BLANCO})${CIERRE}"
  echo ""

  if [[ -s "$TMP/FALLIDOS" ]]; then
    echo "${BLANCO}[${VERDE}*${BLANCO}] Los siguientes updaters tienen VERSION rota o fallaron:${ROJO}"
    sort -u "$TMP/FALLIDOS"
    echo "${CIERRE}"
  else
    echo "${BLANCO}[${VERDE}*${BLANCO}] ${VERDE}!!! Enhorabuena !!!"
    echo "${BLANCO}[${VERDE}*${BLANCO}] Todos los updaters funcionan.${CIERRE}"
  fi
}

LIMPIAR() {
  echo ""
  echo "${BLANCO}[${VERDE}*${BLANCO}] Limpiando directorio temporal...${CIERRE}"
  rm -rf "$TMP"
  echo "${BLANCO}[${VERDE}*${BLANCO}] Bye Bye${CIERRE}"
}

SECONDS=0
BUSQUEDA
TEMPORAL
MOSTRAR
INFORME
LIMPIAR
