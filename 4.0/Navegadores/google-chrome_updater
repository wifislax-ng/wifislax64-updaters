#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261121

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=google-chrome
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://dl.google.com/linux/chrome/deb/dists/stable/main/binary-amd64/Packages
VER_FULL=$(curl -sL --connect-timeout 15 "$WEB" | sed -n '/^Package: google-chrome-stable$/,/^$/s/^Version: \([0-9][0-9.]*-[0-9]*\).*/\1/p' | head -1)
VERSION=${VER_FULL%-*}
RAMA=${VER_FULL#*-}
SOURCES=google-chrome-stable_${VERSION}-${RAMA}_amd64.deb
DOWNLOAD=https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/$SOURCES
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo "$VERDE"
echo "Extrayendo contenido del fichero .deb"
echo "$CIERRE"
mkdir -p "$TMP/deb"
deb2dir "$TMP/$SOURCES" "$TMP/deb" || exit 1
rm -rf "$TMP/deb/etc" "$TMP/deb/usr/share/man" "$TMP/deb/usr/share/doc" "$TMP/deb/usr/share/menu" "$TMP/deb/usr/share/gnome-control-center"
rm -rf "$TMP/deb"/usr/share/applications/*.desktop
rm -f "$TMP/deb/usr/bin/google-chrome"

# Symlink desktop environment icons hicolor
for png in "$TMP/deb"/opt/google/chrome/product_logo_*.png; do
[ -f "$png" ] || continue
pngsize="${png##*/product_logo_}"
mkdir -p "$TMP/deb/usr/share/icons/hicolor/${pngsize%.png}x${pngsize%.png}/apps"
ln -s "../../../../../../opt/google/chrome/product_logo_${pngsize}" "$TMP/deb/usr/share/icons/hicolor/${pngsize%.png}x${pngsize%.png}/apps/google-chrome.png"
done

# Symlink desktop environment icons oxygen
for png in "$TMP/deb"/opt/google/chrome/product_logo_*.png; do
[ -f "$png" ] || continue
pngsize="${png##*/product_logo_}"
mkdir -p "$TMP/deb/usr/share/icons/oxygen/base/${pngsize%.png}x${pngsize%.png}/apps"
ln -s "../../../../../../../opt/google/chrome/product_logo_${pngsize}" "$TMP/deb/usr/share/icons/oxygen/base/${pngsize%.png}x${pngsize%.png}/apps/google-chrome.png"
done

install -Dm 644 "$TMP/deb/opt/google/chrome/product_logo_64.png" "$PKG/usr/share/pixmaps/google-chrome.png"

mkdir -p "$TMP/deb/usr/share/applications" "$PKG/usr/bin"

cat << 'EOF' > "$PKG/usr/bin/google-chrome"
#!/bin/sh
if [ "$(id -u)" = "0" ]; then
exec /opt/google/chrome/google-chrome --test-type --user-data-dir=/root/.config/google-chrome --no-sandbox "$@"
else
exec /opt/google/chrome/google-chrome "$@"
fi
EOF
chmod 0755 "$PKG/usr/bin/google-chrome"

cat << 'EOF' > "$TMP/deb/usr/share/applications/$PRGNAM.desktop"
[Desktop Entry]
Categories=Application;Network;
Encoding=UTF-8
Exec=google-chrome %u
GenericName[es_ES]=Navegador Web
GenericName=Web Browser
Icon=google-chrome
MimeType=text/html;
Name[es_ES]=Google-chrome
Name=Google-chrome
Path=
StartupNotify=false
Terminal=false
TerminalOptions=
Type=Application
X-DBUS-ServiceName=
X-DBUS-StartupType=
X-KDE-SubstituteUID=false
X-KDE-Username=
EOF
chmod 0644 "$TMP/deb/usr/share/applications/$PRGNAM.desktop"
cp -rfp "$TMP"/deb/* "$PKG/" || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# Si se cierra el script inesperadamente, ejecutar la funcion de limpieza
trap f_exitmode SIGHUP SIGINT SIGTERM

#Inicializamos las variables globales
f_variables
#Asignamos o detectamos arquitectura
f_arquitectura
#Comprobamos conexion a Internet
f_comprobarConexion
#Inicializamos las variables del script
F_variables
#Creamos directorio de trabajo
f_directorioTemporal
#Mostramos el mensaje de presentacion
f_presentacion
#Comprobamos updates del script
f_comprobarUpdates
#Comprobamos version instalada del script
f_versionInstalada
#Si no existe el fichero se descargara
f_download
#Descomprimir fichero descargado y compilamos
F_compilar
#Creamos xzm , instalamos y salimos
f_tareasFinales
