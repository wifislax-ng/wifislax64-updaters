#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=firefox
EXTENSION=tar.xz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB="https://download.mozilla.org/?product=firefox-latest&os=linux64&lang=es-ES"
VERSION=$(curl -sI --connect-timeout 15 "$WEB" | sed -n 's|.*[Ll]ocation: .*/firefox-\([0-9][^/]*\)\.tar\..*|\1|p' | head -1)
SOURCES=$PRGNAM-$VERSION.$EXTENSION
DOWNLOAD=https://ftp.mozilla.org/pub/firefox/releases/$VERSION/linux-x86_64/es-ES/$SOURCES
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
mkdir -p "$PKG/usr/lib${LIBDIRSUFFIX}/mozilla/plugins" "$PKG/usr/bin" "$PKG/usr/share/pixmaps" "$PKG/usr/share/applications" "$PKG/usr/lib/mozilla"
cp -a "$TMP/$PRGNAM" "$PKG/usr/lib${LIBDIRSUFFIX}/" || exit 1
ln -s "/usr/lib${LIBDIRSUFFIX}/firefox/firefox" "$PKG/usr/bin/firefox" || exit 1
install -Dm 644 "$TMP/firefox/browser/chrome/icons/default/default128.png" "$PKG/usr/share/pixmaps/firefox.png" || exit 1

for size in 16 32 48 64 128; do
if [ -f "$TMP/firefox/browser/chrome/icons/default/default${size}.png" ]; then
install -Dm 644 "$TMP/firefox/browser/chrome/icons/default/default${size}.png" "$PKG/usr/share/icons/hicolor/${size}x${size}/apps/firefox.png"
fi
done

mkdir -p "$PKG/usr/lib${LIBDIRSUFFIX}/firefox/distribution"
cat << 'EOF' > "$PKG/usr/lib${LIBDIRSUFFIX}/firefox/distribution/policies.json"
{
  "policies": {
    "DisableAppUpdate": true
  }
}
EOF

# Linkeamos plugins en /usr/lib
if [ "$LIBDIRSUFFIX" = "64" ]; then
ln -s "/usr/lib${LIBDIRSUFFIX}/mozilla/plugins" "$PKG/usr/lib/mozilla/plugins"
fi

cat << 'EOF' > "$PKG/usr/share/applications/mozilla-firefox.desktop"
[Desktop Entry]
Encoding=UTF-8
Exec=firefox %u
Icon=firefox
Type=Application
Categories=Application;Network;
Name=Firefox
GenericName[es]=Navegador Web
GenericName=Web Browser
MimeType=text/html
StartupNotify=false
EOF
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Creamos directorio temporal de trabajo
f_directorioTemporal
# 9. Descargamos sources
f_download
# 10. Descomprimimos sources
f_descomprimir
# 11. Configuramos y compilamos
F_compilar
# 12. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
