SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=pocl
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/pocl/pocl
VERSION=$(basename $(curl -sLI -o /dev/null -w '%{url_effective}' $WEB/releases/latest) | tr -d v)
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="llvm ocl-icd"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

cmake \
    -GNinja \
    -Bbuild \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib${LIBDIRSUFFIX} \
    -DKERNELLIB_HOST_CPU_VARIANTS=distro \
    -DINSTALL_OPENCL_HEADERS=OFF \
    -DCMAKE_BUILD_TYPE=Release . || exit 1
    
echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

ninja -C build || exit 1
DESTDIR="$PKG" ninja -C build install || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
