#!/bin/sh

# Script for www.seguridadwireless.net by vk496

SCRIPT_VERSION=20261121

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
   . /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Si el repositorio no responde, salimos del script
F_ping() {
if ! curl -fsI --connect-timeout 5 "$WEB" >/dev/null 2>&1; then
echo "$ROJO"
echo "Parece que el repositorio no responde, intentalo mas tarde."
echo "$CIERRE"
sleep 1
exit 0
fi
}

# Definicion de variables
F_variables() {
PRGNAM=wifislax-updaters
WIFISLAX=$(cut -d ' ' -f2 /etc/wifislax-version|cut -d- -f1)
WEB="https://github.com/wifislax-ng/wifislax64-updaters"
echo -ne "\033]2;${PRGNAM}_updater\007"
VERSION=$(date +"%Y%m%d")
GESTOR=git
CREAR_MODULO=NO
}


# Directorios de trabajo y actualizar
F_actualizar(){

# Creamos la carpeta donde van a estar los scripts
mkdir -p "$PKG" "$PKG/usr/share/applications/wifislax/Actualizadores"
if [ ! -d "$PKG/opt/$PRGNAM" ]; then
   mkdir -p "$PKG/opt/$PRGNAM"
fi

# Creamos directorio temporal de trabajo limpio
rm -rf "/tmp/$PRGNAM"
mkdir -p "/tmp/$PRGNAM"

# Necesario para que funciones calcule el tiempo
COMIENZO=$(date +%s)

git clone --depth 1 "$WEB" "/tmp/$PRGNAM" 2>/dev/null || { rm -rf "/tmp/$PRGNAM"; exit 1; }

if [ ! -d "/tmp/$PRGNAM/$WIFISLAX" ]; then
   echo "$ROJO"
   echo "No se encontro la rama para Wifislax $WIFISLAX en el repositorio."
   echo "$CIERRE"
   rm -rf "/tmp/$PRGNAM"
   exit 1
fi

echo
# Contador de todos los scripts
contador=0

carpetas="$(find "/tmp/$PRGNAM/$WIFISLAX" -mindepth 1 -maxdepth 1 -type d ! -name '.git' -printf '%f\n' | sort)"
# Obtenemos la carpeta del server, y la usamos como carpeta local
for carpeta in $carpetas; do
   archivos="$(find "/tmp/$PRGNAM/$WIFISLAX/$carpeta" -maxdepth 1 -type f -printf '%f\n' | sort)"
   # Obtenemos el archivo del server, y la usamos como archivo local
   for archivo in $archivos; do
      contador=$((contador + 1))
      echo -n "${CYAN}Buscando $archivo... $CIERRE"
         
         # Comprobamos si ya existe ese script
         if [ -f "/opt/$PRGNAM/$carpeta/$archivo" ]; then
        
            # Si se trata de funciones_updater, usamos variables distintas al habitual
            if [ "${archivo}" = "funciones_updater" ]; then
               LOCAL_VERSION=$(grep -m1 "^FUNCIONES_VERSION=" "/opt/$PRGNAM/$carpeta/$archivo" | cut -d "=" -f2 | tr -d '[:space:]')
               WEB_VERSION=$(grep -m1 "^FUNCIONES_VERSION=" "/tmp/$PRGNAM/$WIFISLAX/$carpeta/$archivo" | cut -d "=" -f2 | tr -d '[:space:]')
            else
               LOCAL_VERSION=$(grep -m1 "^SCRIPT_VERSION=" "/opt/$PRGNAM/$carpeta/$archivo" | cut -d "=" -f2 | tr -d '[:space:]')
               WEB_VERSION=$(grep -m1 "^SCRIPT_VERSION=" "/tmp/$PRGNAM/$WIFISLAX/$carpeta/$archivo" | cut -d "=" -f2 | tr -d '[:space:]')
            fi

            LOCAL_VERSION=${LOCAL_VERSION:-0}
            WEB_VERSION=${WEB_VERSION:-0}
            
         echo -n "${VERDE}EXISTE$CIERRE"
	    # Ademas de mirar si existe, comprobamos si existe version mas nueva a la que tenemos nosotros
	    if [ "$LOCAL_VERSION" -lt "$WEB_VERSION" ] 2>/dev/null; then
		CREAR_MODULO=SI
		mkdir -p "$PKG/opt/$PRGNAM/$carpeta"
		cp -f "/tmp/$PRGNAM/$WIFISLAX/$carpeta/$archivo" "$PKG/opt/$PRGNAM/$carpeta/$archivo"
		echo " + ${AMARILLO}ACTUALIZADO $ROSA(${WEB_VERSION:6}/${WEB_VERSION:4:2}/${WEB_VERSION:0:4})$CIERRE"
		chmod +x "$PKG/opt/$PRGNAM/$carpeta/$archivo"
	    else
		echo -e " $BLANCO(${LOCAL_VERSION:6}/${LOCAL_VERSION:4:2}/${LOCAL_VERSION:0:4})$CIERRE"
	    fi
	    
      # Si no existe ese script en nuestro sistema, procedemos a descargarlo
	else
		CREAR_MODULO=SI
		mkdir -p "$PKG/opt/$PRGNAM/$carpeta"
		cp -f "/tmp/$PRGNAM/$WIFISLAX/$carpeta/$archivo" "$PKG/opt/$PRGNAM/$carpeta/$archivo"
		LOCAL_VERSION=$(grep -m1 "^SCRIPT_VERSION=" "$PKG/opt/$PRGNAM/$carpeta/$archivo" | cut -d "=" -f2 | tr -d '[:space:]')
		LOCAL_VERSION=${LOCAL_VERSION:-0}
		chmod +x "$PKG/opt/$PRGNAM/$carpeta/$archivo"
		echo "${ROJO}DESCARGADO$CIERRE $BLANCO($ROSA${LOCAL_VERSION:6}/${LOCAL_VERSION:4:2}/${LOCAL_VERSION:0:4}$BLANCO)$CIERRE"

		case "$archivo" in
			*_updater)
				PRGNAM_CORTO=${archivo%_updater}
				mkdir -p "$PKG/usr/share/applications/wifislax/Actualizadores/$carpeta"
				
				CATEGORIA="$(grep -m1 "^CATEGORIA=" "/tmp/$PRGNAM/$WIFISLAX/$carpeta/$archivo" | cut -d"=" -f2 | tr -d '"[:space:]')"
				if [ -z "$CATEGORIA" ]; then
				  CATEGORIA=$carpeta
				fi
				
# Creamos el desktop del menu
cat << EOF > "$PKG/usr/share/applications/wifislax/Actualizadores/$carpeta/$PRGNAM_CORTO.desktop"
[Desktop Entry]
Categories=$CATEGORIA;
Comment=Updater/Installer
Comment[es]=Actualizador/Instalador
Comment[it]=Aggiornamento/Installazione
Comment[fr]=Programme de mise à jour/installateur
Comment[ge]=Updater/Installer
Exec=sh -c "/opt/wifislax-updaters/$carpeta/$archivo;bash"
Icon=wifislax-updater
MimeType=
Name=$PRGNAM_CORTO
Path=/opt/wifislax-updaters/$carpeta/
Terminal=true
TerminalOptions=
Type=Application
EOF
				chmod 644 "$PKG/usr/share/applications/wifislax/Actualizadores/$carpeta/$PRGNAM_CORTO.desktop"
			;;
		esac

      fi
   done

done

rm -rf "/tmp/$PRGNAM"
sleep 2
echo
}

# Crear estructura
F_estructura(){
if [ "$CREAR_MODULO" = "SI" ]; then
   
   echo -n "${CYAN}Creando logs e instalando....$CIERRE"
   echo -ne "${CYAN} $ROJO$contador${CYAN} scripts$CIERRE"
   sleep 1

   mkdir -p "$PKG/usr/bin/" "$PKG/usr/share/applications/wifislax/Actualizadores/Tools" "$PKG/opt/wifislax-updaters" "$PKG/etc/wifislax-updaters" "$PKG/usr/share/pixmaps"
   cp -Rn /usr/share/applications/wifislax/Actualizadores/* "$PKG/usr/share/applications/wifislax/Actualizadores/" 2>/dev/null
   cp -Rn /opt/wifislax-updaters/* "$PKG/opt/wifislax-updaters/" 2>/dev/null
   cp -Ru /usr/share/pixmaps/{Blacklist_updaters.png,wifislax-updater.png,buscador_updaters.png,Config_updaters.png} "$PKG/usr/share/pixmaps/" 2>/dev/null
   cp -Ru /etc/wifislax-updaters/* "$PKG/etc/wifislax-updaters/" 2>/dev/null
   cp -Ru /usr/bin/{buscador_updaters,Config_updaters,Blacklist_updaters,slackbuilds.txt_updater,base_updater} "$PKG/usr/bin/" 2>/dev/null
   
if [ -d "$PKG/usr/share/applications/wifislax/Actualizadores/Funciones" ]; then
   rm -rf "$PKG/usr/share/applications/wifislax/Actualizadores/Funciones"
fi
fi
cd ..
}

F_final(){
if [ "$CREAR_MODULO" != "SI" ]; then
echo "$VERDE"
echo "No hay actualizaciones para los updaters"
sleep 1
echo
echo "Bye Bye"
echo "$CIERRE"
f_exitmode
exit 1
fi
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# Si se cierra el script inesperadamente, ejecutar la funcion de limpieza
trap f_exitmode SIGHUP SIGINT SIGTERM

# Inicializamos las variables globales
f_variables
# Comprobamos conexion a Internet
f_comprobarConexion
# Inicializamos las variables del script
F_variables
# Creamos directorio de trabajo
f_directorioTemporal
# Mostramos el mensaje de presentacion
f_presentacion
# Si el repositorio no responde, salimos del script
F_ping
# Comprobamos updates del script
f_comprobarUpdates
# Asignamos o detectamos arquitectura
f_arquitectura noarch
# Directorios de trabajo y actualizar
F_actualizar
# Crear estructura
F_estructura
# Creamos xzm , instalamos y salimos
F_final
# Creamos xzm , instalamos y salimos
f_tareasFinales
