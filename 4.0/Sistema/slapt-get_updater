#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=slapt-get
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB="https://github.com/jaos/$PRGNAM"
VERSION=$(git ls-remote --tags --refs "$WEB.git" | awk -F/ '{print $NF}' | sort -V | tail -n1)
SOURCES="$VERSION.$EXTENSION"
CD="$PRGNAM-$VERSION"
DOWNLOAD="$WEB/archive/refs/tags/$SOURCES"
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
rm -rf build
CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
	meson setup build \
	  --prefix=/usr \
	  --libdir=/usr/lib${LIBDIRSUFFIX} \
	  --sysconfdir=/etc \
	  --mandir=/usr/man \
	  --buildtype=release \
	  -Dwerror=false || exit 1

ninja -C build || exit 1
DESTDIR="$PKG" ninja -C build install || exit 1

# Copiamos nuestra config actual al paquete
mkdir -p "$PKG/etc/slapt-get"
rm -rf "$PKG/etc/slapt-get/slapt-getrc.new"
cp -f /etc/slapt-get/slapt-getrc "$PKG/etc/slapt-get/"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Creamos directorio temporal de trabajo
f_directorioTemporal
# 9. Descargamos sources
f_download
# 10. Descomprimimos sources
f_descomprimir
# 11. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 12. Configuramos y compilamos
F_compilar
# 13. Hacemos strip sobre el paquete
f_strip
# 14. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
