#!/bin/bash

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127
SUBCATEGORIA="Editores de video"

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################

F_variables() {
PRGNAM=avidemux
EXTENSION=tar.xz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://ponce.cc/slackware/sources/repo
VERSION=$(curl -fsL --compressed --connect-timeout 15 "$WEB/" | grep -oE "${PRGNAM}_[0-9]{8}_[a-z0-9]+\.$EXTENSION" | sort -V | tail -n 1 | sed -E "s/^${PRGNAM}_//; s/\.$EXTENSION$//")
SOURCES=${PRGNAM}_${VERSION}.$EXTENSION
CD=${PRGNAM}_${VERSION}
DOWNLOAD=$WEB/${PRGNAM}_$VERSION.$EXTENSION
}

F_dependencias(){
DEPENDENCIAS="
faad2
libdca
libfdk-aac
opencore-amr
twolame
x264
x265
xvidcore
aften
dcaenc
faac"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "$VERDE"Compilando ..."$CIERRE"
sleep 1
 
sed -i 's|0.19|1.0|' avidemux_plugins/ADM_videoFilters6/ass/CMakeLists.txt 2>/dev/null || true
bash bootStrap.bash --with-core --with-cli --with-plugins --enable-qt5 || exit 1
make -C buildCli DESTDIR="$PKG" install || exit 1
make -C buildCore DESTDIR="$PKG" install || exit 1
make -C buildPluginsCLI DESTDIR="$PKG" install || exit 1
make -C buildPluginsCommon DESTDIR="$PKG" install || exit 1
install -Dm 644 avidemux_icon.png "$PKG/usr/share/pixmaps/avidemux.png" || exit 1
make -C buildQt5 DESTDIR="$PKG" install || exit 1
make -C buildPluginsQt5 DESTDIR="$PKG" install || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Hacemos strip sobre el paquete
f_strip
# 15. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
