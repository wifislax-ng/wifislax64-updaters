#!/bin/bash

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127
SUBCATEGORIA="Editores de video"

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=aegisub
SRCNAM=Aegisub
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://github.com/TypesettingTools/$SRCNAM
VERSION=$(git ls-remote --tags --refs --sort="v:refname" "$WEB.git" | grep -E 'refs/tags/v?[0-9]+\.[0-9]+(\.[0-9]+)?$' | tail -n 1 | sed -E 's/.*\/v?//')
SOURCES=v$VERSION.$EXTENSION
CD=$SRCNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="
unifdef
libwpe
wpebackend-fdo
bubblewrap
geoclue2
xdg-dbus-proxy
webkit2gtk4.1
nanosvg
wxWidgets
ffms2
libuchardet"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "$VERDE"Configurando ..."$CIERRE"
sleep 1

sed "/subdir('tests')/d" -i meson.build
echo "#define BUILD_GIT_VERSION_NUMBER ${VERSION//./}" > git_version.h
echo "#define BUILD_GIT_VERSION_STRING \"${VERSION}\"" >> git_version.h
echo '#define TAGGED_RELEASE 0' >> git_version.h
echo '#define INSTALLER_VERSION "0.0.0"' >> git_version.h
echo '#define RESOURCE_BASE_VERSION 0, 0, 0' >> git_version.h

echo 
echo "$VERDE"Compilando ..."$CIERRE"

  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS -fpermissive" \
  meson setup build \
    --buildtype=release \
    --infodir=/usr/info \
    --libdir=/usr/lib${LIBDIRSUFFIX} \
    --localstatedir=/var \
    --mandir=/usr/man \
    --prefix=/usr \
    --sysconfdir=/etc \
    -Dopenal=disabled \
    -Dportaudio=disabled \
    -Dsystem_luajit=true \
    -Denable_update_checker=false \
    -Dstrip=true || exit 1

"${NINJA:=ninja}" -C build || exit 1
DESTDIR="$PKG" $NINJA -C build install || exit 1
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Hacemos strip sobre el paquete
f_strip
# 15. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
