SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=airgeddon
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/v1s1t0r1sh3r3/$PRGNAM
VERSION=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$WEB/releases/latest" | sed -E 's|.*/tag/v?||')
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="aircrack-ng arping-th reaver bully ccze crunch hashcat hcxdumptool hcxtools hostapd mdk3 mdk4 john"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

mkdir -p "$PKG/usr/bin"
mkdir -p "$PKG/usr/share/airgeddon"

rm -rf *.md .git* .editor* binaries imgs Dockerfile pindb_checksum.txt

cp -a --no-preserve=ownership * "$PKG/usr/share/airgeddon/"
find "$PKG/usr/share/airgeddon" -type f -name "*.sh" -exec chmod +x {} +

if [ -f .airgeddonrc ]; then
    cp -a --no-preserve=ownership .airgeddonrc "$PKG/usr/share/airgeddon/"
    sed -i -E 's/^(AIRGEDDON_AUTO_UPDATE=)"?true"?/\1false/' "$PKG/usr/share/airgeddon/.airgeddonrc"
fi

cat > "$PKG/usr/bin/airgeddon" << 'EOF'
#!/bin/sh
cd /usr/share/airgeddon || exit 1
exec bash airgeddon.sh "$@"
EOF

chmod a+x "$PKG/usr/bin/airgeddon"
}

