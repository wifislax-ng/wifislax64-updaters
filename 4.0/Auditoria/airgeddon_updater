#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=airgeddon
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://github.com/v1s1t0r1sh3r3/$PRGNAM
VERSION=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$WEB/releases/latest" | sed -E 's|.*/tag/v?([0-9.]+).*|\1|')
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="aircrack-ng arping-th reaver bully ccze crunch hashcat hcxdumptool hcxtools hostapd mdk3 mdk4 john"
f_dependencias
}

# Preparamos e instalamos los ficheros en PKG
F_compilar(){
echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

mkdir -p "$PKG/usr/bin"
mkdir -p "$PKG/usr/share/airgeddon"

rm -rf -- *.md .git* .editor* binaries imgs Dockerfile pindb_checksum.txt

cp -a --no-preserve=ownership . "$PKG/usr/share/airgeddon/"
find "$PKG/usr/share/airgeddon" -type f -name "*.sh" -exec chmod +x {} +

if [ -f "$PKG/usr/share/airgeddon/.airgeddonrc" ]; then
    sed -i -E 's/^(AIRGEDDON_AUTO_UPDATE=)"?true"?/\1false/' "$PKG/usr/share/airgeddon/.airgeddonrc"
fi

cat > "$PKG/usr/bin/airgeddon" << 'EOF'
#!/bin/sh
cd /usr/share/airgeddon || exit 1
exec bash airgeddon.sh "$@"
EOF

chmod a+x "$PKG/usr/bin/airgeddon"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
