############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=aircrack-ng
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://www.aircrack-ng.org
VERSION=$(curl -fsSL "$WEB/" | grep -oE "aircrack-ng-[0-9.]+\.${EXTENSION}" | head -n 1 | sed -E "s/aircrack-ng-|\.${EXTENSION}//g")
SOURCES=$PRGNAM-$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=https://download.aircrack-ng.org/$SOURCES
}

F_dependencias(){
DEPENDENCIAS="
ethtool
glibc
hwloc
iw
gcc
libnl3
libpcap
net-tools
openssl
pcre
python3
sqlite
usbutils
wireless_tools
zlib
python-setuptools
cmocka"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

autoreconf -fiv || exit 1

LDFLAGS="-L/usr/lib${LIBDIRSUFFIX}" \
CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
PYTHON="/usr/bin/python3" \
./configure \
  --prefix=/usr \
  --libdir=/usr/lib${LIBDIRSUFFIX} \
  --sbindir=/usr/bin \
  --sysconfdir=/etc \
  --localstatedir=/var \
  --mandir=/usr/man \
  --docdir=/usr/doc/$PRGNAM-$VERSION \
  --with-experimental \
  --with-ext-scripts \
  --build=$ARCH-slackware-linux || exit 1

echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

make -j$(nproc) || exit 1
make DESTDIR="$PKG" install || exit 1

# Creamos el fichero oui directamente en $PKG usando el propio airodump-ng-oui-update
echo "$VERDE"
echo "Actualizando aircrack oui.list ...."
echo "$AMARILLO"

mkdir -p "$PKG/etc/aircrack-ng"
OUI_UPDATER_TMP=$(mktemp)

if [ -f "$PKG/usr/bin/airodump-ng-oui-update" ]; then
    sed "s|\"/etc/aircrack-ng\"|\"$PKG/etc/aircrack-ng\"|g" "$PKG/usr/bin/airodump-ng-oui-update" > "$OUI_UPDATER_TMP"
    chmod +x "$OUI_UPDATER_TMP"
    if ( cd /tmp && sh "$OUI_UPDATER_TMP" ) && [ -s "$PKG/etc/aircrack-ng/airodump-ng-oui.txt" ]; then
        echo "${VERDE}Lista OUI actualizada correctamente mediante airodump-ng-oui-update.${CIERRE}"
    else
        echo "${ROJO}Aviso: No se pudo actualizar la lista OUI.${CIERRE}"
    fi
else
    echo "${ROJO}Aviso: No se encontró airodump-ng-oui-update en $PKG/usr/bin.${CIERRE}"
fi
rm -f "$OUI_UPDATER_TMP" /tmp/oui.txt
}

