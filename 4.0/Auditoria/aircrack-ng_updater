#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=aircrack-ng
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://www.aircrack-ng.org
VERSION=$(curl -fsSL "$WEB/" | grep -oE "aircrack-ng-[0-9.]+\.${EXTENSION}" | head -n 1 | sed -E "s/aircrack-ng-|\.${EXTENSION}//g")
SOURCES=$PRGNAM-$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=https://download.aircrack-ng.org/$SOURCES
}

F_dependencias(){
DEPENDENCIAS="
ethtool
glibc
hwloc
iw
gcc
libnl3
libpcap
net-tools
openssl
pcre
python3
sqlite
usbutils
wireless_tools
zlib
python-setuptools
cmocka"
f_dependencias
}

# Configuramos y compilamos
F_compilar(){
echo 
echo "${VERDE}Configurando ...${CIERRE}"
sleep 1

autoreconf -fiv || exit 1

LDFLAGS="-L/usr/lib${LIBDIRSUFFIX}" \
CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
PYTHON="/usr/bin/python3" \
./configure \
  --prefix=/usr \
  --libdir=/usr/lib${LIBDIRSUFFIX} \
  --sbindir=/usr/bin \
  --sysconfdir=/etc \
  --localstatedir=/var \
  --mandir=/usr/man \
  --docdir=/usr/doc/$PRGNAM-$VERSION \
  --with-experimental \
  --with-ext-scripts \
  --build=$ARCH-slackware-linux || exit 1

echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

make || exit 1
make DESTDIR="$PKG" install || exit 1

# Creamos el fichero oui directamente en $PKG usando el propio airodump-ng-oui-update
echo "$VERDE"
echo "Actualizando aircrack oui.list ...."
echo "$AMARILLO"

mkdir -p "$PKG/etc/aircrack-ng"
OUI_UPDATER_TMP="$TMP/airodump-ng-oui-update.tmp"

if [ -f "$PKG/usr/bin/airodump-ng-oui-update" ]; then
    sed "s|/etc/aircrack-ng|$PKG/etc/aircrack-ng|g" "$PKG/usr/bin/airodump-ng-oui-update" > "$OUI_UPDATER_TMP"
    if grep -q "$PKG/etc/aircrack-ng" "$OUI_UPDATER_TMP"; then
        chmod +x "$OUI_UPDATER_TMP"
        if ( cd "$TMP" && sh "$OUI_UPDATER_TMP" ) && [ -s "$PKG/etc/aircrack-ng/airodump-ng-oui.txt" ]; then
            echo "${VERDE}Lista OUI actualizada correctamente mediante airodump-ng-oui-update.${CIERRE}"
        else
            echo "${ROJO}Aviso: No se pudo actualizar la lista OUI.${CIERRE}"
        fi
    else
        echo "${ROJO}Aviso: No se pudo redirigir la ruta en airodump-ng-oui-update.${CIERRE}"
    fi
else
    echo "${ROJO}Aviso: No se encontró airodump-ng-oui-update en $PKG/usr/bin.${CIERRE}"
fi
rm -f "$OUI_UPDATER_TMP" "$TMP/oui.txt"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Descomprimimos sources
f_descomprimir
# 12. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 13. Configuramos y compilamos
F_compilar
# 14. Hacemos strip sobre el paquete
f_strip
# 15. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
