#!/bin/bash

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables() {
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
F_variables() {
PRGNAM=wifijammer
GESTOR=git
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://github.com/Theelx/$PRGNAM
VERSION="0.1_$(git ls-remote "$WEB.git" HEAD | cut -c 1-7)"
SOURCES=$PRGNAM
CD=$PRGNAM
DOWNLOAD=$WEB
}

F_dependencias() {
DEPENDENCIAS="python3 python3-scapy"
f_dependencias
}

F_compilar() {
echo -e "\n${VERDE}Compilando ...${CIERRE}"
if [ -f setup.py ]; then
	python3 setup.py build || exit 1
	python3 setup.py install --root="$PKG" --prefix='/usr' --optimize=1 --skip-build || exit 1
else
	install -Dm755 "$PRGNAM.py" "$PKG/usr/bin/$PRGNAM" || exit 1
fi
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura noarch
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Comprobamos e instalamos dependencias
F_dependencias
# 9. Creamos directorio temporal de trabajo
f_directorioTemporal
# 10. Descargamos sources
f_download
# 11. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 12. Configuramos y compilamos
F_compilar
# 13. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
