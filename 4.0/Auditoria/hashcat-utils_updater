#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261120

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=hashcat-utils
EXTENSION=tar.gz
GESTOR=wget
echo -ne "\033]2;${PRGNAM}_updater\007"
WEB=https://github.com/hashcat/$PRGNAM
VERSION=$(curl -fsSL "https://api.github.com/repos/hashcat/$PRGNAM/releases/latest" | grep -oE '"tag_name":\s*"v?[0-9.]+"' | sed -E 's/.*"v?([0-9.]+)".*/\1/')
SOURCES=v$VERSION.$EXTENSION
CD=$PRGNAM-$VERSION
DOWNLOAD=$WEB/archive/refs/tags/$SOURCES
}

# Comprobar dependencias
F_dependencias(){
DEPENDENCIAS="perl"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
echo 
echo "${VERDE}Compilando ...${CIERRE}"
sleep 1

make -j$(nproc) -C src || exit 1

for bin in src/*.bin; do
	[ -f "$bin" ] && install -Dm755 "$bin" "$PKG/usr/bin/$(basename "$bin" .bin)" || exit 1
done

for script in src/*.pl; do
	[ -f "$script" ] && install -Dm755 "$script" "$PKG/usr/bin/$(basename "$script")" || exit 1
done

mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a README* LICENSE* "$PKG/usr/doc/$PRGNAM-$VERSION/" 2>/dev/null
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# Si se cierra el script inesperadamente, ejecutar la funcion de limpieza
trap f_exitmode SIGHUP SIGINT SIGTERM

#Inicializamos las variables globales
f_variables
#Asignamos o detectamos arquitectura
f_arquitectura
#Comprobamos conexion a Internet
f_comprobarConexion
#Inicializamos las variables del script
F_variables
#Creamos directorio de trabajo
f_directorioTemporal
#Mostramos el mensaje de presentacion
f_presentacion
#Comprobamos updates del script
f_comprobarUpdates
#Comprobamos version instalada del paquete
f_versionInstalada
#Comprobar dependencias
F_dependencias
#Si no existe el fichero se descargara
f_download
#Descomprimir sources
f_descomprimir
#Cd a ruta
f_cd
#Descomprimir fichero descargado y compilamos
F_compilar
#Hacemos strip sobre el paquete
f_strip
#Creamos xzm , instalamos y salimos
f_tareasFinales
