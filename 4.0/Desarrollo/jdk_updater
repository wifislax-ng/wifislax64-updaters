#!/bin/sh

# Script by www.seguridadwireless.net

SCRIPT_VERSION=20261127

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
	. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=jdk
SRCNAM=jdk-25_linux-x64_bin
EXTENSION=tar.gz
GESTOR=curl
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://www.oracle.com/java/technologies/downloads/
VERSION=$(curl -fsSL -A "Mozilla/5.0" "$WEB" | grep -oE '25\.[0-9]+\.[0-9]+(\.[0-9]+)?' | sort -V | tail -n 1)

SOURCES=$SRCNAM.$EXTENSION
CD="jdk-25*"
DOWNLOAD=https://download.oracle.com/java/25/latest/$SOURCES
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
printf '\n%bConfigurando ...%b\n' "$VERDE" "$CIERRE"
sleep 1

mkdir -p "$PKG/etc/profile.d" "$PKG/usr/bin" "$PKG/usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION"

printf '\n%bCompilando ...%b\n' "$VERDE" "$CIERRE"
sleep 1

cp -a bin conf include jmods lib "$PKG/usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION/" || exit 1

cd "$PKG/usr/lib${LIBDIRSUFFIX}" || exit 1
for _lib in libjawt.so server/libjvm.so libjava.so libawt.so libawt_xawt.so libverify.so; do
	[ -e "$PRGNAM-$VERSION/lib/$_lib" ] && ln -sf "$PRGNAM-$VERSION/lib/$_lib" .
done

cd "$PKG/usr/bin" || exit 1
for _bin in "$PKG/usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION/bin/"*; do
	if [ -x "$_bin" ]; then
		_bin_name="${_bin##*/}"
		ln -sf "/usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION/bin/$_bin_name" "$_bin_name"
	fi
done

cd "$PKG" || exit 1
cat > "etc/profile.d/$PRGNAM.sh" << EOF
#!/bin/sh
export JAVA_HOME=/usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION
export PATH=\${PATH}:\${JAVA_HOME}/bin
EOF

cat > "etc/profile.d/$PRGNAM.csh" << EOF
#!/bin/csh
setenv JAVA_HOME /usr/lib${LIBDIRSUFFIX}/$PRGNAM-$VERSION
setenv PATH \${PATH}:\${JAVA_HOME}/bin
EOF

chmod 755 etc/profile.d/*
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# 1. Inicializamos variables globales, trap y autodetección de PRGNAM
f_variables
# 2. Detectamos arquitectura del sistema
f_arquitectura
# 3. Comprobamos conexión a Internet
f_comprobarConexion
# 4. Mostramos el mensaje de presentación
f_presentacion
# 5. Comprobamos updates del propio script
f_comprobarUpdates "$@"
# 6. Inicializamos las variables propias del paquete (consulta WEB/VERSION/DOWNLOAD)
F_variables
# 7. Comprobamos versión instalada en el sistema y pedimos confirmación
f_versionInstalada
# 8. Creamos directorio temporal de trabajo
f_directorioTemporal
# 9. Descargamos sources
f_download
# 10. Descomprimimos sources
f_descomprimir
# 11. Entramos en el directorio descomprimido y ajustamos permisos
f_cd
# 12. Configuramos y compilamos
F_compilar
# 13. Creamos paquete (xzm/txz), instalamos, limpiamos y salimos
f_tareasFinales
