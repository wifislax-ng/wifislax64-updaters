SCRIPT_VERSION=20261121

############################################################
## Funciones comunes. Su nombre empieza por f_ ##
############################################################
f_variables(){
. /opt/wifislax-updaters/Funciones/funciones_updater
}

############################################################
## Funciones propias del script. Su nombre empieza por F_ ##
############################################################
# Definicion de variables
F_variables() {
PRGNAM=openoffice
EXTENSION=tar.gz
GESTOR=wget
printf '\033]2;%s_updater\007' "$PRGNAM"
WEB=https://sourceforge.net/projects/openofficeorg.mirror/files
VERSION=$(curl -sL --connect-timeout 15 "https://sourceforge.net/projects/openofficeorg.mirror/rss?path=/" | sed -n 's|.*/\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)/binaries/.*|\1|p' | head -1)
RAMA=$(printf '%s' "$VERSION" | cut -f1 -d.)
SOURCES=Apache_OpenOffice_${VERSION}_Linux_x86-64_install-rpm_$IDIOMA.$EXTENSION
CD=$IDIOMA/RPMS/desktop-integration
DOWNLOAD=$WEB/$VERSION/binaries/$IDIOMA/$SOURCES
}

# Comprobacion de dependencias
F_dependencias(){
DEPENDENCIAS="rpm cpio"
f_dependencias
}

# Descomprimimos el fichero descargado y compilamos
F_compilar(){
mkdir -p "$PKG/usr/bin" "$PKG/usr/share/applications" "$PKG/usr/share/icons" "$PKG/opt/${PRGNAM}${RAMA}/lang"
rm -f *onlineupdate*.rpm

for FILE in *freedesktop-menus*.rpm; do
[ -f "$FILE" ] || continue
rpm2cpio < "$FILE" | cpio -imdv || exit 1
done

if [ -d "$TMP/$IDIOMA/RPMS/desktop-integration/usr/share/icons" ]; then
cp -a "$TMP/$IDIOMA/RPMS/desktop-integration/usr/share/icons/"* "$PKG/usr/share/icons/"
fi
rm -rf "$TMP/$IDIOMA/RPMS/desktop-integration"

cd "$TMP/$IDIOMA/RPMS" || exit 1
for FILE in *.rpm; do
[ -f "$FILE" ] || continue
rpm2cpio < "$FILE" | cpio -imdv || exit 1
done
rm -f "$TMP/$IDIOMA/RPMS/"*.rpm

cp -a opt "$PKG/" || exit 1

cat << EOT > "$PKG/usr/bin/${PRGNAM}$RAMA"
#!/bin/sh
exec /opt/${PRGNAM}${RAMA}/program/soffice "\$@"
EOT
chmod 0755 "$PKG/usr/bin/${PRGNAM}$RAMA"
ln -s "${PRGNAM}$RAMA" "$PKG/usr/bin/soffice"

for APP in base calc draw impress math writer; do
if [ -f "$PKG/opt/${PRGNAM}${RAMA}/share/xdg/$APP.desktop" ]; then
cp -av "$PKG/opt/${PRGNAM}${RAMA}/share/xdg/$APP.desktop" "$PKG/usr/share/applications/open-$APP.desktop"
chmod 0644 "$PKG/usr/share/applications/open-$APP.desktop"
fi
done

rm -rf "$TMP/$IDIOMA/RPMS"
if [ -d "$TMP/$IDIOMA" ]; then
cp -a "$TMP/$IDIOMA/." "$PKG/opt/${PRGNAM}${RAMA}/lang/"
fi

chown -R root:root "$PKG"
}

###################################
## BLOQUE PRINCIPAL DE EJECUCION ##
###################################
# Si se cierra el script inesperadamente, ejecutar la funcion de limpieza
trap f_exitmode SIGHUP SIGINT SIGTERM

#Inicializamos las variables globales
f_variables
#Asignamos o detectamos arquitectura
f_arquitectura
#Comprobamos conexion a Internet
f_comprobarConexion
#Inicializamos las variables del script
F_variables
#Comprobamos dependencias
F_dependencias
#Creamos directorio de trabajo
f_directorioTemporal
#Mostramos el mensaje de presentacion
f_presentacion
#Comprobamos updates del script
f_comprobarUpdates
#Comprobamos version instalada del paquete
f_versionInstalada
#Si no existe el fichero se descargara
f_download
#Descomprimir sources
f_descomprimir
#Cd a ruta
f_cd
#Descomprimir fichero descargado y compilamos
F_compilar
#Creamos xzm , instalamos y salimos
f_tareasFinales
